---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import TopBar from '../components/sections/TopBar.astro';
import Hero from '../components/sections/Hero.astro';
import Esencia from '../components/sections/Esencia.astro';
import Experiencias from '../components/sections/Experiencias.astro';
import Carta from '../components/sections/Carta.astro';
import Calculadora from '../components/sections/Calculadora.astro';
import Reservas from '../components/sections/Reservas.astro';
import FAQ from '../components/sections/FAQ.astro';
import Location from '../components/sections/Location.astro';
import Footer from '../components/sections/Footer.astro';
import WhatsAppFab from '../components/ui/WhatsAppFab.astro';
import { SITE_CONFIG } from '../data/siteConfig';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SITE_CONFIG.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title={SITE_CONFIG.seo.title}
  description={SITE_CONFIG.seo.description}
  ogImage={SITE_CONFIG.seo.ogImage}
  jsonLd={faqJsonLd}
>
  <TopBar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <Esencia />
    <Experiencias />
    <Carta />
    <Calculadora />
    <Reservas />
    <FAQ />
    <Location />
  </main>
  <Footer />
  <WhatsAppFab />
</Layout>
