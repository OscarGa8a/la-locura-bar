---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<section
  id="esencia"
  class="relative bg-paper text-ink py-20 md:py-28 lg:py-36 px-4 sm:px-6 lg:px-12 border-b border-line-light/50"
  aria-label="La Esencia del Parche"
>
  <div class="max-w-7xl mx-auto">
    <!-- Eyebrow -->
    <div class="flex items-center gap-2 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <span class="font-body text-xs md:text-sm font-semibold tracking-[0.2em] text-accent uppercase">
        {SITE_CONFIG.esencia.eyebrow}
      </span>
    </div>

    <!-- Editorial Asymmetrical Grid (Desktop ~58% / ~42%) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Left Column: Dominant Headline -->
      <div class="lg:col-span-7">
        <h2 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl tracking-tight text-ink leading-[0.92] uppercase text-balance">
          {SITE_CONFIG.esencia.title}
        </h2>
      </div>

      <!-- Right Column: Narrative Body + Signature -->
      <div class="lg:col-span-5 flex flex-col justify-between pt-2 lg:pt-3">
        <!-- Subtle Divider on mobile/desktop -->
        <div class="w-12 h-0.5 bg-primary mb-6"></div>

        <p class="font-body text-lg sm:text-xl text-ink-muted leading-relaxed mb-8 text-pretty">
          {SITE_CONFIG.esencia.body}
        </p>

        <!-- Signature -->
        <div class="pt-6 border-t border-line-light/40 flex items-center justify-between">
          <span class="font-display text-sm tracking-[0.25em] text-ink-muted uppercase">
            {SITE_CONFIG.esencia.signature}
          </span>
          <span class="font-accent text-2xl text-primary transform -rotate-6">
            Puro barrio
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
