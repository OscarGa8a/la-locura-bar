---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<section
  id="esencia"
  class="relative bg-[#F4ECE1] text-ink py-16 sm:py-24 lg:py-32 px-5 sm:px-8 lg:px-12 border-b border-[#D8CDC0]/70 overflow-hidden select-none"
  aria-label="La Esencia del Parche"
>
  <!-- Background Chalk Watermark "48" (Bottom-Left) -->
  <div class="absolute -bottom-8 -left-8 sm:bottom-0 sm:left-0 z-0 pointer-events-none select-none opacity-40">
    <img
      src="/images/v2/esencia_chalk48.png"
      alt=""
      class="w-56 sm:w-80 md:w-96 lg:w-[26rem] h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Desktop Graffiti Magenta Slash (Top-Right bleeding off edge) -->
  <div class="hidden sm:block absolute top-0 right-0 z-0 pointer-events-none select-none">
    <img
      src="/images/v2/esencia_spray_desktop.png"
      alt=""
      class="w-48 md:w-60 lg:w-72 xl:w-80 h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Mobile Graffiti Magenta Slash (Bottom-Right matching mobile mockup) -->
  <div class="sm:hidden absolute -bottom-8 -right-6 z-0 pointer-events-none select-none">
    <img
      src="/images/v2/esencia_spray_mobile.png"
      alt=""
      class="w-36 h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Editorial Two-Column Asymmetrical Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Left Column: Dominant Headline & Crown (Desktop ~58%, Mobile 1 col) -->
      <div class="lg:col-span-7">
        <!-- Eyebrow -->
        <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-primary uppercase mb-4 sm:mb-6">
          {SITE_CONFIG.esencia.eyebrow}
        </span>

        <!-- Headline Container -->
        <div class="relative w-fit">
          <!-- Desktop H2 (Strictly 2 lines matching desktop mockup) -->
          <div class="hidden sm:block relative">
            <h2 class="font-display tracking-tight leading-[0.84] uppercase select-none text-6xl md:text-7xl lg:text-[6.5rem] xl:text-[7.5rem]">
              <span class="flex items-center gap-4 text-ink whitespace-nowrap">
                EL PLAN NO
                <img
                  src="/images/v2/esencia_crown.png"
                  alt=""
                  class="w-14 sm:w-16 md:w-20 lg:w-24 h-auto object-contain transform rotate-12 -mt-4 lg:-mt-6"
                  aria-hidden="true"
                />
              </span>
              <span class="block text-primary whitespace-nowrap">NECESITA EXCUSA.</span>
            </h2>

            <!-- Desktop Brush Underline -->
            <div class="mt-2 sm:mt-3 w-full max-w-xl lg:max-w-2xl pointer-events-none select-none">
              <img
                src="/images/v2/esencia_underline.png"
                alt=""
                class="w-full h-auto object-contain"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Mobile H2 (3 lines matching mobile mockup) -->
          <div class="sm:hidden relative">
            <h2 class="font-display text-6xl tracking-tight leading-[0.86] uppercase select-none">
              <span class="block text-ink">EL PLAN NO</span>
              <span class="flex items-center gap-3 text-primary">
                NECESITA
                <img
                  src="/images/v2/esencia_crown.png"
                  alt=""
                  class="w-12 h-auto object-contain transform rotate-12 -mt-2"
                  aria-hidden="true"
                />
              </span>
              <span class="block text-primary">EXCUSA.</span>
            </h2>

            <!-- Mobile Brush Underline (Tightly under EXCUSA.) -->
            <div class="mt-2 w-56 pointer-events-none select-none">
              <img
                src="/images/v2/esencia_underline.png"
                alt=""
                class="w-full h-auto object-contain"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative Body & Signature (Desktop ~42%) -->
      <div class="lg:col-span-5 lg:border-l lg:border-[#C8BEB2]/60 lg:pl-12 flex flex-col justify-center">
        <!-- Text Paragraph formatted with authentic line breaks matching mockup -->
        <p class="font-body text-base sm:text-lg lg:text-xl text-[#211C1A] leading-relaxed mb-6 sm:mb-8 text-pretty">
          Con amigos, en pareja<br />
          o por tu cuenta.<br />
          Aquí puedes llegar<br />
          sin formalidades,<br />
          pedir tu música y armar<br />
          el parche a tu ritmo.
        </p>

        <!-- Divider line -->
        <div class="w-12 h-[2px] bg-primary mb-4 sm:mb-5"></div>

        <!-- Official Brand Signature -->
        <span class="font-display text-xs sm:text-sm tracking-[0.22em] text-primary uppercase font-bold">
          {SITE_CONFIG.esencia.signature}
        </span>
      </div>
    </div>
  </div>
</section>


