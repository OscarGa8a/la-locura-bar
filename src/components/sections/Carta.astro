---
import { SITE_CONFIG, MENU_PRODUCTS } from '../../data/siteConfig';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { formatCOP } from '../../utils/whatsapp';

const categories = SITE_CONFIG.carta.categories;
---

<section
  id="carta"
  class="relative bg-[#F4ECE1] text-ink py-16 sm:py-20 lg:py-28 px-4 sm:px-6 lg:px-12 border-b border-[#D8CDC0]/70 overflow-hidden select-none"
  aria-label="Carta de Bebidas"
>
  <!-- Background Chalk Watermark "48" (Bottom-Left matching design) -->
  <div class="absolute -bottom-10 -left-10 sm:bottom-0 sm:left-0 z-0 pointer-events-none select-none opacity-25 lg:opacity-35">
    <img
      src="/images/v2/esencia_chalk48.png"
      alt=""
      class="w-60 sm:w-72 md:w-80 lg:w-96 xl:w-[26rem] h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Background Spray Graffiti Splatter (Bottom-Right matching design) -->
  <div class="absolute -bottom-8 -right-6 sm:bottom-0 sm:right-0 z-0 pointer-events-none select-none opacity-85">
    <img
      src="/images/v2/esencia_spray_desktop.png"
      alt=""
      class="w-36 sm:w-48 lg:w-64 h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Top-Right Magenta Graffiti Crown (Matching desktop & mobile mockups) -->
  <div class="absolute top-3 sm:top-6 right-4 sm:right-6 lg:right-14 z-0 pointer-events-none select-none">
    <img
      src="/images/v2/esencia_crown.png"
      alt=""
      class="w-10 sm:w-16 md:w-20 lg:w-28 h-auto object-contain opacity-90 transform rotate-6"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header (Editorial layout with narrative column) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 lg:mb-12 gap-6">
      <div class="max-w-2xl">
        <!-- Eyebrow -->
        <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-primary uppercase mb-2 sm:mb-3">
          {SITE_CONFIG.carta.eyebrow}
        </span>

        <!-- Headline with Pink Brush Underline -->
        <h2 class="font-display tracking-tight leading-[0.88] uppercase select-none text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] text-ink">
          ¿QUÉ SE VA A{' '}
          <span class="text-primary inline-block relative whitespace-nowrap">
            TOMAR?
            <img
              src="/images/v2/esencia_underline.png"
              alt=""
              class="absolute -bottom-1 sm:-bottom-2 left-0 w-full h-2.5 sm:h-3.5 object-fill pointer-events-none select-none"
              aria-hidden="true"
            />
          </span>
        </h2>

        <!-- Mobile supporting text -->
        <p class="md:hidden font-body text-sm text-ink-muted mt-3 leading-relaxed">
          {SITE_CONFIG.carta.description}
        </p>
      </div>

      <!-- Desktop Narrative Text with Vertical Divider -->
      <div class="hidden md:flex items-center border-l border-[#D8CDC0] pl-6 max-w-xs self-end mb-2">
        <p class="font-body text-sm lg:text-base text-ink-muted leading-snug">
          Conoce nuestras bebidas<br />y arma tu plan sin sorpresas.
        </p>
      </div>
    </div>

    <!-- Category Tabs (Interactive Pills) -->
    <div
      class="flex overflow-x-auto pb-2 scrollbar-none gap-2 sm:gap-3.5 mb-8 sm:mb-10"
      role="tablist"
      aria-label="Categorías de bebidas"
    >
      {categories.map((cat, idx) => {
        const isActive = idx === 0;
        return (
          <button
            type="button"
            role="tab"
            id={`tab-btn-${cat.id}`}
            data-category-tab={cat.id}
            aria-selected={isActive ? 'true' : 'false'}
            aria-controls={`tab-panel-${cat.id}`}
            class={`flex items-center gap-2 sm:gap-2.5 px-4 sm:px-6 py-2.5 sm:py-3 rounded-lg font-display text-sm sm:text-base md:text-lg uppercase tracking-wider whitespace-nowrap transition-all cursor-pointer border ${
              isActive
                ? 'bg-[#121212] text-white border-[#121212] shadow-sm'
                : 'bg-[#F4ECE1] text-ink border-[#D8CDC0] hover:bg-[#EAE1D5] hover:border-[#C4B7A7]'
            }`}
          >
            <Icon
              name={cat.icon || 'beer'}
              size="sm"
              class={isActive ? 'text-secondary' : 'text-ink/80'}
            />
            <span class="font-bold">{cat.label}</span>
          </button>
        );
      })}
    </div>

    <!-- Tab Panels -->
    {categories.map((cat, idx) => {
      const items = MENU_PRODUCTS.filter((p) => p.category === cat.id);
      const featuredItems = items.filter((p) => p.featured);
      const otherItems = items.filter((p) => !p.featured);
      const isActive = idx === 0;

      return (
        <div
          id={`tab-panel-${cat.id}`}
          role="tabpanel"
          aria-labelledby={`tab-btn-${cat.id}`}
          class={`${isActive ? 'block' : 'hidden'} tab-content-panel`}
        >
          {/* Featured Photographic Cards (Side by side grid matching mockups) */}
          {featuredItems.length > 0 && (
            <div class="grid grid-cols-2 gap-3 sm:gap-5 md:gap-6 mb-8 sm:mb-12">
              {featuredItems.slice(0, 2).map((item) => {
                const nameWords = item.name.split(' ');
                const hasTwoWords = nameWords.length === 2 && item.name.length > 10;

                return (
                  <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[3/4] sm:aspect-[16/11] md:aspect-[16/10] bg-[#1a1617] border border-white/10 shadow-lg group">
                    {/* Photo background */}
                    <img
                      src={item.image || '/images/v2/menu-cervezas.png'}
                      alt={item.name}
                      class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />

                    {/* Dark Vignette Overlay for High Readability */}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent sm:bg-gradient-to-r sm:from-black/85 sm:via-black/35 sm:to-transparent" />

                    {/* Content Overlay */}
                    <div class="relative z-10 p-3.5 sm:p-6 lg:p-8 flex flex-col justify-between h-full max-w-full sm:max-w-[70%]">
                      <div>
                        {/* Mini Graffiti Crown */}
                        <img
                          src="/images/v2/esencia_crown.png"
                          alt=""
                          class="w-5 sm:w-7 md:w-8 h-auto object-contain mb-1 sm:mb-1.5 opacity-90 drop-shadow-sm"
                          aria-hidden="true"
                        />

                        {/* Tag */}
                        <span class="block font-body text-[10px] sm:text-xs md:text-sm font-bold tracking-[0.2em] text-secondary uppercase">
                          {item.tag || 'DESTACADA'}
                        </span>

                        {/* Product Name (stacked cleanly if 2 words) */}
                        <h3 class="font-display text-xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-tight text-white leading-[0.92] mt-0.5 sm:mt-1 mb-1 drop-shadow-sm">
                          {hasTwoWords ? (
                            <>
                              <span class="block">{nameWords[0]}</span>
                              <span class="block">{nameWords[1]}</span>
                            </>
                          ) : (
                            item.name
                          )}
                        </h3>

                        {/* Presentation */}
                        <p class="font-body text-[11px] sm:text-xs md:text-sm text-white/80">
                          {item.presentation}
                        </p>
                      </div>

                      {/* Price */}
                      <div class="mt-2 sm:mt-4">
                        <span class="font-display text-xl sm:text-3xl md:text-4xl lg:text-5xl text-secondary tracking-tight leading-none drop-shadow-sm">
                          {formatCOP(item.price)}
                        </span>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          {/* OTRAS OPCIONES — 3-Column Editorial Grid on Desktop, Clean List on Mobile */}
          {otherItems.length > 0 && (
            <div>
              <!-- Desktop Header -->
              <div class="hidden sm:block mb-5 sm:mb-6">
                <h3 class="font-display text-2xl sm:text-3xl md:text-4xl text-ink uppercase tracking-tight">
                  OTRAS OPCIONES
                </h3>
              </div>

              <!-- Mobile Header with Underline -->
              <div class="sm:hidden mb-4 border-b border-[#D8CDC0]/70 pb-2">
                <div class="relative inline-block">
                  <h3 class="font-display text-xl text-ink uppercase tracking-tight">
                    {cat.label}
                  </h3>
                  <img
                    src="/images/v2/esencia_underline.png"
                    alt=""
                    class="absolute -bottom-2 left-0 w-24 h-1.5 object-fill pointer-events-none"
                    aria-hidden="true"
                  />
                </div>
              </div>

              <!-- Product Grid (Responsive columns: 1 on mobile, 2 on tablet, 3 on desktop) -->
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 xl:gap-x-12 gap-y-1 sm:gap-y-1.5">
                {otherItems.map((item) => (
                  <div class="flex items-center justify-between py-2 sm:py-2.5 border-b border-[#D8CDC0]/70 group hover:bg-black/[0.02] transition-colors">
                    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 pr-2">
                      {item.image ? (
                        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-md overflow-hidden bg-black/5 flex items-center justify-center shrink-0 border border-black/10 shadow-2xs">
                          <img
                            src={item.image}
                            alt={item.name}
                            class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-300"
                            loading="lazy"
                          />
                        </div>
                      ) : item.bottleImage ? (
                        <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center shrink-0">
                          <img
                            src={item.bottleImage}
                            alt=""
                            class="max-h-full max-w-full object-contain filter drop-shadow-xs"
                            loading="lazy"
                            aria-hidden="true"
                          />
                        </div>
                      ) : (
                        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-md bg-black/5 flex items-center justify-center shrink-0 border border-black/5">
                          <Icon name="bottle" size="sm" class="text-ink/60" />
                        </div>
                      )}
                      <span class="font-body font-bold text-sm sm:text-base text-ink truncate">
                        {item.name}
                      </span>
                      <span class="font-body text-xs sm:text-sm text-ink-muted shrink-0">
                        {item.presentation}
                      </span>
                    </div>
                    <div class="flex items-center gap-1 font-body font-extrabold text-sm sm:text-base text-ink tabular-nums whitespace-nowrap pl-2">
                      <span>{formatCOP(item.price)}</span>
                      <Icon name="chevron-right" size="xs" class="sm:hidden text-ink/40 ml-1" />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      );
    })}

    <!-- Bottom Action to Calculator (Amber Pill Button using Button primitive) -->
    <div class="mt-8 sm:mt-12 flex justify-end">
      <Button
        href="#calculadora"
        variant="primary"
        size="lg"
        class="w-full sm:w-auto rounded-xl px-8 py-3.5 sm:py-4 group"
      >
        <Icon name="calculator" size="md" class="text-dark group-hover:scale-110 transition-transform" />
        <span>CALCULA TU CUENTA</span>
        <Icon name="arrow-right" size="sm" class="text-dark group-hover:translate-x-1 transition-transform" />
      </Button>
    </div>
  </div>
</section>

<script>
  function setupCartaTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-tab]');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-content-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-category-tab');
        if (!targetId) return;

        // Update button visual states
        tabButtons.forEach((b) => {
          const isCurrent = b === btn;
          b.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
          const icon = b.querySelector('svg');

          if (isCurrent) {
            b.classList.remove('bg-[#F4ECE1]', 'text-ink', 'border-[#D8CDC0]');
            b.classList.add('bg-[#121212]', 'text-white', 'border-[#121212]', 'shadow-sm');
            if (icon) {
              icon.classList.remove('text-ink/80');
              icon.classList.add('text-secondary');
            }
          } else {
            b.classList.remove('bg-[#121212]', 'text-white', 'border-[#121212]', 'shadow-sm');
            b.classList.add('bg-[#F4ECE1]', 'text-ink', 'border-[#D8CDC0]');
            if (icon) {
              icon.classList.remove('text-secondary');
              icon.classList.add('text-ink/80');
            }
          }
        });

        // Show matching panel
        tabPanels.forEach((panel) => {
          if (panel.id === `tab-panel-${targetId}`) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('block');
          }
        });
      });
    });
  }

  // Initialize on load and on astro page swaps
  setupCartaTabs();
  document.addEventListener('astro:page-load', setupCartaTabs);
</script>
