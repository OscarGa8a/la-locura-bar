---
import Icon from '../ui/Icons.astro';
import { NAV_LINKS } from '../../data/content';
import { config } from '../../data/config';
---

<div
  id="menu-overlay"
  class="hidden fixed inset-0 z-50 bg-bg/95 backdrop-blur-xl flex flex-col py-12 px-6 pb-10 overflow-auto md:py-16 md:px-12 transition-all"
  role="dialog"
  aria-modal="true"
  aria-labelledby="menu-overlay-title"
  aria-hidden="true"
>
  <div class="max-w-xl mx-auto w-full flex flex-col h-full">
    <div class="flex items-center justify-between pb-6 border-b border-line">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
        <span class="font-mono text-xs uppercase tracking-ultra text-accent">MENÚ DE NAVEGACIÓN</span>
      </div>

      <!-- Close button -->
      <button
        type="button"
        data-menu-close
        class="w-10 h-10 rounded-full border border-line-strong bg-bg-2 flex items-center justify-center text-fg hover:border-accent hover:text-accent active:scale-90 transition-all cursor-pointer select-none"
        aria-label="Cerrar menú de navegación"
      >
        <Icon name="close" />
      </button>
    </div>

    <h2 id="menu-overlay-title" class="visually-hidden">Menú de navegación</h2>

    <!-- Nav links -->
    <nav class="flex flex-col my-auto py-6" aria-label="Navegación móvil">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="group py-4.5 border-b border-line/60 font-display text-3xl md:text-4xl font-normal tracking-wide uppercase flex justify-between items-center text-fg hover:text-accent transition-all duration-200 select-none"
        >
          <span class="transition-transform duration-200 group-hover:translate-x-2">{link.label}</span>
          <Icon name="arrow" class="text-accent transition-transform duration-200 group-hover:translate-x-1" />
        </a>
      ))}
    </nav>

    <!-- WhatsApp CTA -->
    <div class="mt-auto pt-6 border-t border-line">
      <a
        href={config.whatsappReserveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 w-full py-4 px-6 bg-accent text-bg rounded-xl font-display text-base md:text-lg tracking-wider uppercase shadow-[0_0_25px_rgba(255,45,135,0.4)] hover:shadow-[0_0_35px_rgba(255,45,135,0.6)] active:scale-[0.98] transition-all select-none cursor-pointer"
        aria-label="Reservar por WhatsApp de La Locura Bar"
      >
        <Icon name="whatsapp" size="lg" />
        <span>Reserva por WhatsApp</span>
      </a>
    </div>
  </div>
</div>
