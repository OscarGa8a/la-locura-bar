---
import { SITE_CONFIG } from '../../data/siteConfig';

const item1 = SITE_CONFIG.experiencias.items[0];
const item2 = SITE_CONFIG.experiencias.items[1];
const item3 = SITE_CONFIG.experiencias.items[2];
---

<section
  id="experiencias"
  class="relative bg-background text-text py-20 sm:py-24 lg:py-32 px-5 sm:px-8 lg:px-12 border-b border-line/40 overflow-hidden select-none"
  aria-label="Experiencias en La Locura Bar"
>
  <!-- Top-Right Magenta Graffiti Tag bleeding off edge -->
  <div class="absolute top-0 right-0 z-0 pointer-events-none select-none">
    <img
      src="/images/v2/experiencias_spray.png"
      alt=""
      class="w-44 sm:w-56 md:w-64 lg:w-72 xl:w-80 h-auto object-contain"
      aria-hidden="true"
      loading="eager"
    />
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header (Editorial layout with headline, amber crown, and narrative) -->
    <div class="mb-12 sm:mb-16 lg:mb-20">
      <!-- Eyebrow -->
      <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-3 sm:mb-4">
        {SITE_CONFIG.experiencias.eyebrow}
      </span>

      <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-12 xl:gap-16">
        <!-- Main Headline Container -->
        <div class="relative w-fit">
          <!-- Desktop / Tablet Headline -->
          <div class="hidden sm:block relative">
            <h2 class="font-display tracking-tight leading-[0.86] uppercase select-none text-5xl sm:text-6xl md:text-7xl lg:text-[4.75rem] xl:text-[5.5rem]">
              <span class="block text-white whitespace-nowrap">ENTRE CANCIONES</span>
              <span class="block text-primary whitespace-nowrap">Y REVANCHAS.</span>
            </h2>

            <!-- Amber Crown (Positioned to the right of headline on desktop) -->
            <div class="absolute -top-3 sm:-top-5 -right-12 sm:-right-16 md:-right-18 lg:-right-20 pointer-events-none select-none">
              <img
                src="/images/v2/experiencias_crown.png"
                alt=""
                class="w-12 sm:w-14 md:w-16 lg:w-18 h-auto object-contain transform rotate-12"
                aria-hidden="true"
              />
            </div>

            <!-- Magenta Brush Underline (under Y REVANCHAS.) -->
            <div class="mt-2 w-[88%] sm:w-[90%] max-w-lg pointer-events-none select-none">
              <img
                src="/images/v2/esencia_underline.png"
                alt=""
                class="w-full h-auto object-contain"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Mobile Headline (390px safe, crown placed organically) -->
          <div class="sm:hidden relative">
            <div class="flex items-start justify-between gap-3">
              <h2 class="font-display tracking-tight leading-[0.86] uppercase select-none text-5xl">
                <span class="block text-white">ENTRE CANCIONES</span>
                <span class="block text-primary">Y REVANCHAS.</span>
              </h2>
              <img
                src="/images/v2/experiencias_crown.png"
                alt=""
                class="w-10 h-auto object-contain transform rotate-12 shrink-0 -mt-1"
                aria-hidden="true"
              />
            </div>

            <!-- Mobile Brush Underline -->
            <div class="mt-2 w-[85%] max-w-xs pointer-events-none select-none">
              <img
                src="/images/v2/esencia_underline.png"
                alt=""
                class="w-full h-auto object-contain"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>

        <!-- Vertical Divider & Narrative Body -->
        <div class="border-l border-white/20 pl-6 lg:pl-8 flex flex-col justify-center max-w-sm">
          <p class="font-body text-sm sm:text-base lg:text-lg text-white/80 leading-relaxed text-pretty">
            Un lugar para jugar,<br />
            escuchar tu música<br />
            y compartir el parche.
          </p>
        </div>
      </div>
    </div>

    <!-- Asymmetrical Mosaic Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      <!-- Dominant Feature: Bolirrana (Left ~58% on desktop) -->
      {item1 && (
        <div class="lg:col-span-7 group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-surface border border-white/10 min-h-[460px] md:min-h-[520px] lg:h-full flex flex-col justify-end p-6 sm:p-8 lg:p-10 transition-all duration-300 hover:border-white/20">
          <img
            src={item1.image}
            alt={item1.alt}
            class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            decoding="async"
          />
          <!-- Multi-stop Dark Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-transparent"></div>
          
          <div class="relative z-10">
            <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2 sm:mb-3">
              {item1.category}
            </span>
            <h3 class="font-display text-4xl sm:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] uppercase leading-[0.88] tracking-tight mb-2">
              <span class="block text-white">{item1.titleLine1 || 'LA REVANCHA'}</span>
              <span class="block text-primary">{item1.titleLine2 || 'SE JUEGA AQUÍ.'}</span>
            </h3>
            <p class="font-body text-sm sm:text-base text-white/80 font-normal">
              {item1.subtitle}
            </p>
          </div>
        </div>
      )}

      <!-- Secondary Features: Música + Pantalla (Right ~42% on desktop, stacked) -->
      <div class="lg:col-span-5 flex flex-col gap-6 lg:gap-8">
        <!-- Card 02: Música -->
        {item2 && (
          <div class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-surface border border-white/10 min-h-[240px] sm:min-h-[260px] flex-1 flex flex-col justify-end p-6 sm:p-8 transition-all duration-300 hover:border-white/20">
            <img
              src={item2.image}
              alt={item2.alt}
              class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent"></div>
            
            <div class="relative z-10">
              <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2">
                {item2.category}
              </span>
              <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase leading-[0.88] tracking-tight mb-2">
                <span class="block text-white">{item2.titleLine1 || 'TÚ PIDES'}</span>
                <span class="block text-primary">{item2.titleLine2 || 'LA CANCIÓN.'}</span>
              </h3>
              <!-- Secondary Divider Line -->
              <div class="w-10 h-0.5 bg-secondary my-2.5"></div>
              <p class="font-body text-xs sm:text-sm text-white/80 font-normal">
                {item2.subtitle}
              </p>
            </div>
          </div>
        )}

        <!-- Card 03: Pantalla / Deportes -->
        {item3 && (
          <div class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-surface border border-white/10 min-h-[240px] sm:min-h-[260px] flex-1 flex flex-col justify-end p-6 sm:p-8 transition-all duration-300 hover:border-white/20">
            <img
              src={item3.image}
              alt={item3.alt}
              class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent"></div>
            
            <div class="relative z-10">
              <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2">
                {item3.category}
              </span>
              <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase leading-[0.88] tracking-tight mb-2">
                <span class="block text-white">{item3.titleLine1 || 'EL DEPORTE'}</span>
                <span class="block text-primary">{item3.titleLine2 || 'SE VIVE EN GRANDE.'}</span>
              </h3>
              <!-- Secondary Divider Line -->
              <div class="w-10 h-0.5 bg-secondary my-2.5"></div>
              <p class="font-body text-xs sm:text-sm text-white/80 font-normal">
                {item3.subtitle}
              </p>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>


