---
import { SITE_CONFIG } from '../../data/siteConfig';

const item1 = SITE_CONFIG.experiencias.items[0];
const item2 = SITE_CONFIG.experiencias.items[1];
const item3 = SITE_CONFIG.experiencias.items[2];
---

<section
  id="experiencias"
  class="relative bg-background text-text py-16 sm:py-20 lg:py-24 xl:py-28 px-5 sm:px-8 lg:px-12 border-b border-line/40 overflow-hidden select-none"
  aria-label="Experiencias en La Locura Bar"
>
  <!-- Top-Right Magenta Graffiti Tag bleeding off edge -->
  <div class="absolute top-0 right-0 z-0 pointer-events-none select-none">
    <img
      src="/images/v2/experiencias_spray.png"
      alt=""
      class="w-44 sm:w-56 md:w-64 lg:w-72 xl:w-80 h-auto object-contain"
      aria-hidden="true"
      loading="eager"
    />
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header (Editorial layout with headline, amber crown, and narrative) -->
    <div class="mb-8 sm:mb-10 lg:mb-12">
      <div class="grid grid-cols-12 gap-3 sm:gap-6 lg:gap-10 items-center">
        <!-- Main Headline Container (Left Column ~60%) -->
        <div class="col-span-7 sm:col-span-7 lg:col-span-7 relative">
          <!-- Eyebrow -->
          <span class="block font-body text-xxs sm:text-xs lg:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2 sm:mb-3">
            {SITE_CONFIG.experiencias.eyebrow}
          </span>

          <h2 class="font-display tracking-tight leading-[0.88] uppercase select-none text-3xl sm:text-5xl md:text-6xl lg:text-[4.5rem] xl:text-[5.25rem]">
            <span class="block text-white whitespace-nowrap">ENTRE CANCIONES</span>
            <span class="block text-primary whitespace-nowrap">Y REVANCHAS.</span>
          </h2>

          <!-- Magenta Brush Underline (under Y REVANCHAS.) -->
          <div class="mt-1.5 sm:mt-2 w-[85%] sm:w-[90%] max-w-lg pointer-events-none select-none">
            <img
              src="/images/v2/esencia_underline.png"
              alt=""
              class="w-full h-auto object-contain"
              aria-hidden="true"
            />
          </div>
        </div>

        <!-- Vertical Divider & Narrative Body (Right Column ~40%) -->
        <div class="col-span-5 sm:col-span-5 lg:col-span-5 border-l border-white/20 pl-3 sm:pl-5 lg:pl-8 flex flex-col justify-center">
          <!-- Amber Crown (Tilted and placed above narrative text) -->
          <div class="mb-1.5 sm:mb-2.5">
            <img
              src="/images/v2/experiencias_crown.png"
              alt=""
              class="w-7 sm:w-10 md:w-12 lg:w-14 h-auto object-contain transform rotate-6"
              aria-hidden="true"
            />
          </div>

          <p class="font-body text-[11px] sm:text-sm md:text-base lg:text-lg text-white/80 leading-snug sm:leading-relaxed text-pretty">
            Un lugar para jugar,<br />
            escuchar tu música<br />
            y compartir el parche.
          </p>
        </div>
      </div>
    </div>

    <!-- Asymmetrical Mosaic Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-4 lg:gap-4 xl:gap-5 items-stretch lg:h-[540px]">
      <!-- Dominant Feature: Bolirrana (Left ~58% on desktop) -->
      {item1 && (
        <>
          <!-- Mobile / Tablet (< lg): Standard Flat Rectangular Card -->
          <div class="lg:hidden group relative rounded-xl overflow-hidden bg-surface border border-white/10 min-h-[460px] md:min-h-[520px] flex flex-col justify-end p-6 sm:p-8 transition-all duration-300 hover:border-white/20">
            <img
              src={item1.image}
              alt={item1.alt}
              class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-transparent"></div>
            
            <div class="relative z-10">
              <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2 sm:mb-3">
                {item1.category}
              </span>
              <h3 class="font-display text-4xl sm:text-5xl uppercase leading-[0.88] tracking-tight mb-2">
                <span class="block text-white">{item1.titleLine1 || 'LA REVANCHA'}</span>
                <span class="block text-primary">{item1.titleLine2 || 'SE JUEGA AQUÍ.'}</span>
              </h3>
              <!-- Secondary Divider Line -->
              <div class="w-10 sm:w-12 h-0.5 bg-secondary my-2.5"></div>
              <p class="font-body text-sm sm:text-base text-white/80 font-normal">
                {item1.subtitle}
              </p>
            </div>
          </div>

          <!-- Desktop (>= lg): Slanted Top, Flat Bottom, Rounded Corners & 1px Stroke -->
          <div class="hidden lg:flex lg:col-span-7 group relative h-full flex-col justify-end p-8 lg:p-10 transition-all duration-300">
            <!-- SVG Masked Background Image, Gradient & Crisp Border -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 737 540" preserveAspectRatio="none">
              <defs>
                <clipPath id="c1-desktop-clip">
                  <path d="
                    M 0 78
                    Q 0 66 12 66
                    L 725 32
                    Q 737 32 737 44
                    L 737 528
                    Q 737 540 725 540
                    L 12 540
                    Q 0 540 0 528
                    Z
                  " />
                </clipPath>
                <linearGradient id="c1-desktop-grad" x1="0" y1="1" x2="0" y2="0">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.95" />
                  <stop offset="45%" stop-color="#000000" stop-opacity="0.45" />
                  <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g clip-path="url(#c1-desktop-clip)">
                <image
                  href={item1.image}
                  width="737"
                  height="540"
                  preserveAspectRatio="xMidYMid slice"
                  class="transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <rect width="737" height="540" fill="url(#c1-desktop-grad)" />
              </g>
              <path
                d="
                  M 0 78
                  Q 0 66 12 66
                  L 725 32
                  Q 737 32 737 44
                  L 737 528
                  Q 737 540 725 540
                  L 12 540
                  Q 0 540 0 528
                  Z
                "
                fill="none"
                stroke="rgba(255,255,255,0.12)"
                stroke-width="1.2"
                vector-effect="non-scaling-stroke"
                class="transition-colors duration-300 group-hover:stroke-white/20"
              />
            </svg>

            <!-- Card Content (Standard DOM, 100% accessible, flat horizontal) -->
            <div class="relative z-10">
              <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2 sm:mb-3">
                {item1.category}
              </span>
              <h3 class="font-display text-4xl sm:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] uppercase leading-[0.88] tracking-tight mb-2">
                <span class="block text-white">{item1.titleLine1 || 'LA REVANCHA'}</span>
                <span class="block text-primary">{item1.titleLine2 || 'SE JUEGA AQUÍ.'}</span>
              </h3>
              <!-- Secondary Divider Line -->
              <div class="w-10 sm:w-12 h-0.5 bg-secondary my-2.5"></div>
              <p class="font-body text-sm sm:text-base text-white/80 font-normal">
                {item1.subtitle}
              </p>
            </div>
          </div>
        </>
      )}

      <!-- Secondary Features: Música + Pantalla (Right ~42% on desktop, perfectly continuing the diagonal) -->
      <div class="lg:col-span-5 flex flex-col gap-3.5 sm:gap-4 lg:gap-3.5 xl:gap-4 h-full">
        <!-- Card 02: Música (Continuous diagonal top, parallel bottom) -->
        {item2 && (
          <>
            <!-- Mobile / Tablet (< lg): Standard Flat Rectangular Card -->
            <div class="lg:hidden group relative rounded-xl overflow-hidden bg-surface border border-white/10 min-h-[240px] sm:min-h-[260px] flex-1 flex flex-col justify-end p-6 sm:p-8 transition-all duration-300 hover:border-white/20">
              <img
                src={item2.image}
                alt={item2.alt}
                class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent"></div>
              
              <div class="relative z-10">
                <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2">
                  {item2.category}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl uppercase leading-[0.88] tracking-tight mb-2">
                  <span class="block text-white">{item2.titleLine1 || 'TÚ PIDES'}</span>
                  <span class="block text-primary">{item2.titleLine2 || 'LA CANCIÓN.'}</span>
                </h3>
                <!-- Secondary Divider Line -->
                <div class="w-10 h-0.5 bg-secondary my-2.5"></div>
                <p class="font-body text-xs sm:text-sm text-white/80 font-normal">
                  {item2.subtitle}
                </p>
              </div>
            </div>

            <!-- Desktop (>= lg): Seamless continuation of Card 1's diagonal with steeper incline -->
            <div class="hidden lg:flex group relative h-[260px] flex-col justify-end p-6 sm:p-8 transition-all duration-300">
              <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 527 260" preserveAspectRatio="none">
                <defs>
                  <clipPath id="c2-desktop-clip">
                    <path d="
                      M 0 43
                      Q 0 31 12 31
                      L 515 0
                      Q 527 0 527 12
                      L 527 225
                      Q 527 237 515 237
                      L 12 268
                      Q 0 268 0 256
                      Z
                    " />
                  </clipPath>
                  <linearGradient id="c2-desktop-grad" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#000000" stop-opacity="0.95" />
                    <stop offset="50%" stop-color="#000000" stop-opacity="0.5" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <g clip-path="url(#c2-desktop-clip)">
                  <image
                    href={item2.image}
                    width="527"
                    height="260"
                    preserveAspectRatio="xMidYMid slice"
                    class="transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                  <rect width="527" height="260" fill="url(#c2-desktop-grad)" />
                </g>
                <path
                  d="
                    M 0 43
                    Q 0 31 12 31
                    L 515 0
                    Q 527 0 527 12
                    L 527 225
                    Q 527 237 515 237
                    L 12 268
                    Q 0 268 0 256
                    Z
                  "
                  fill="none"
                  stroke="rgba(255,255,255,0.12)"
                  stroke-width="1.2"
                  vector-effect="non-scaling-stroke"
                  class="transition-colors duration-300 group-hover:stroke-white/20"
                />
              </svg>

              <div class="relative z-10">
                <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2">
                  {item2.category}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase leading-[0.88] tracking-tight mb-2">
                  <span class="block text-white">{item2.titleLine1 || 'TÚ PIDES'}</span>
                  <span class="block text-primary">{item2.titleLine2 || 'LA CANCIÓN.'}</span>
                </h3>
                <!-- Secondary Divider Line -->
                <div class="w-10 h-0.5 bg-secondary my-2.5"></div>
                <p class="font-body text-xs sm:text-sm text-white/80 font-normal">
                  {item2.subtitle}
                </p>
              </div>
            </div>
          </>
        )}

        <!-- Card 03: Pantalla / Deportes -->
        {item3 && (
          <>
            <!-- Mobile / Tablet (< lg): Standard Flat Rectangular Card -->
            <div class="lg:hidden group relative rounded-xl overflow-hidden bg-surface border border-white/10 min-h-[240px] sm:min-h-[260px] flex-1 flex flex-col justify-end p-6 sm:p-8 transition-all duration-300 hover:border-white/20">
              <img
                src={item3.image}
                alt={item3.alt}
                class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent"></div>
              
              <div class="relative z-10">
                <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2">
                  {item3.category}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl uppercase leading-[0.88] tracking-tight mb-2">
                  <span class="block text-white">{item3.titleLine1 || 'EL DEPORTE'}</span>
                  <span class="block text-primary">{item3.titleLine2 || 'SE VIVE EN GRANDE.'}</span>
                </h3>
                <!-- Secondary Divider Line -->
                <div class="w-10 h-0.5 bg-secondary my-2.5"></div>
                <p class="font-body text-xs sm:text-sm text-white/80 font-normal">
                  {item3.subtitle}
                </p>
              </div>
            </div>

            <!-- Desktop (>= lg): Slanted Top (parallel to Card 2), Flat Bottom (horizontal), Rounded Corners -->
            <div class="hidden lg:flex group relative flex-1 flex-col justify-end p-6 sm:p-8 transition-all duration-300">
              <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 527 264" preserveAspectRatio="none">
                <defs>
                  <clipPath id="c3-desktop-clip">
                    <path d="
                      M 0 43
                      Q 0 31 12 31
                      L 515 0
                      Q 527 0 527 12
                      L 527 252
                      Q 527 264 515 264
                      L 12 264
                      Q 0 264 0 252
                      Z
                    " />
                  </clipPath>
                  <linearGradient id="c3-desktop-grad" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#000000" stop-opacity="0.95" />
                    <stop offset="50%" stop-color="#000000" stop-opacity="0.5" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <g clip-path="url(#c3-desktop-clip)">
                  <image
                    href={item3.image}
                    width="527"
                    height="264"
                    preserveAspectRatio="xMidYMid slice"
                    class="transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                  <rect width="527" height="264" fill="url(#c3-desktop-grad)" />
                </g>
                <path
                  d="
                    M 0 43
                    Q 0 31 12 31
                    L 515 0
                    Q 527 0 527 12
                    L 527 252
                    Q 527 264 515 264
                    L 12 264
                    Q 0 264 0 252
                    Z
                  "
                  fill="none"
                  stroke="rgba(255,255,255,0.12)"
                  stroke-width="1.2"
                  vector-effect="non-scaling-stroke"
                  class="transition-colors duration-300 group-hover:stroke-white/20"
                />
              </svg>

              <!-- Card Content -->
              <div class="relative z-10">
                <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2">
                  {item3.category}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase leading-[0.88] tracking-tight mb-2">
                  <span class="block text-white">{item3.titleLine1 || 'EL DEPORTE'}</span>
                  <span class="block text-primary">{item3.titleLine2 || 'SE VIVE EN GRANDE.'}</span>
                </h3>
                <!-- Secondary Divider Line -->
                <div class="w-10 h-0.5 bg-secondary my-2.5"></div>
                <p class="font-body text-xs sm:text-sm text-white/80 font-normal">
                  {item3.subtitle}
                </p>
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>


