---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<header
  id="header-global"
  class="fixed top-0 left-0 right-0 z-40 transition-colors duration-300 bg-background/80 backdrop-blur-md border-b border-line/40 py-3.5 px-4 sm:px-6 lg:px-12"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logo -->
    <a
      href="#inicio"
      class="flex items-center gap-2.5 text-text hover:text-secondary transition-colors group select-none"
      aria-label="La Locura Bar — ir al inicio"
    >
      <img
        src="/images/logo.png"
        alt=""
        width="40"
        height="40"
        class="w-9 h-9 sm:w-10 sm:h-10 object-contain"
        loading="eager"
      />
      <span class="font-display text-2xl sm:text-3xl tracking-wide uppercase text-text group-hover:text-secondary transition-colors">
        LA LOCURA
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      <ul class="flex items-center gap-6 text-sm font-body font-medium tracking-wide">
        {SITE_CONFIG.navigation.desktop.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-muted hover:text-text transition-colors py-1 inline-block"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Desktop CTA -->
      <a
        href={SITE_CONFIG.navigation.cta.href}
        class="inline-flex items-center justify-center bg-secondary text-dark font-display text-base tracking-wider uppercase px-5 py-2.5 rounded-sm hover:bg-gold-soft active:scale-95 transition-all font-semibold"
      >
        {SITE_CONFIG.navigation.cta.label}
      </a>
    </nav>

    <!-- Mobile Navigation Actions -->
    <div class="flex items-center gap-2.5 lg:hidden">
      <a
        href={SITE_CONFIG.navigation.cta.href}
        class="inline-flex items-center justify-center bg-secondary text-dark font-display text-sm tracking-wider uppercase px-3.5 py-1.5 rounded-sm font-semibold active:scale-95 transition-all"
      >
        Reservar
      </a>
      <button
        type="button"
        id="btn-open-menu"
        class="p-2 text-text hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary rounded-sm"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-50 bg-background/95 backdrop-blur-xl flex flex-col p-6 transition-all duration-300 opacity-0 pointer-events-none -translate-y-4"
  role="dialog"
  aria-modal="true"
  aria-label="Explora La Locura"
>
  <div class="flex items-center justify-between pb-6 border-b border-line/40">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="font-display text-xl tracking-wider text-text uppercase">Explora La Locura</span>
    </div>
    <button
      type="button"
      id="btn-close-menu"
      class="p-2 text-muted hover:text-text rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
      aria-label="Cerrar menú"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="flex flex-col py-8 gap-4 overflow-y-auto" aria-label="Navegación móvil">
    {SITE_CONFIG.navigation.mobile.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link font-display text-2xl uppercase tracking-wide text-text hover:text-secondary transition-colors py-2 border-b border-line/20 flex items-center justify-between"
      >
        <span>{item.label}</span>
        <span class="text-xs text-muted font-body">→</span>
      </a>
    ))}
  </nav>

  <div class="mt-auto pt-6 border-t border-line/40">
    <a
      href={SITE_CONFIG.navigation.cta.href}
      class="mobile-nav-link flex items-center justify-center w-full py-3.5 bg-secondary text-dark font-display text-lg uppercase tracking-wider rounded-sm font-semibold hover:bg-gold-soft transition-colors"
    >
      {SITE_CONFIG.navigation.cta.label}
    </a>
  </div>
</div>

<script>
  const header = document.getElementById('header-global');
  const openBtn = document.getElementById('btn-open-menu');
  const closeBtn = document.getElementById('btn-close-menu');
  const drawer = document.getElementById('mobile-menu-drawer');
  const navLinks = drawer?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

  // Sticky header background transition
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 30) {
      header.classList.add('bg-background/95', 'shadow-lg', 'border-line/80');
      header.classList.remove('bg-background/80', 'border-line/40');
    } else {
      header.classList.add('bg-background/80', 'border-line/40');
      header.classList.remove('bg-background/95', 'shadow-lg', 'border-line/80');
    }
  });

  function openMenu() {
    if (!drawer || !openBtn) return;
    drawer.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
    drawer.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!drawer || !openBtn) return;
    drawer.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
    drawer.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  navLinks?.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('opacity-100')) {
      closeMenu();
    }
  });
</script>
