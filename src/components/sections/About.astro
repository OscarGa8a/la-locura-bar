---
import { CldImage } from 'astro-cloudinary';
import { PUBLIC_CLOUDINARY_CLOUD_NAME } from 'astro:env/client';
import SectionHeader from '../ui/SectionHeader.astro';
import { COPY_NEON, ABOUT_GALLERY } from '../../data/content';

const stats = [
  { n: '+8', l: 'Referencias de cerveza' },
  { n: '6', l: 'Días abiertos' },
  { n: '2024', l: 'Año de apertura' },
];

const hasCloudinary = Boolean(PUBLIC_CLOUDINARY_CLOUD_NAME);

function getGridClasses(position: number): string {
  const base: Record<number, string> = {
    0: 'row-span-2 sm:col-span-2 sm:row-span-2 md:col-span-2 md:row-span-2 lg:col-span-2 lg:row-span-2',
    1: 'row-span-2 sm:col-span-1 sm:row-span-1 md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1',
    2: 'row-span-2 sm:col-span-1 sm:row-span-2 md:col-span-1 md:row-span-2 lg:col-span-1 lg:row-span-2',
    3: 'row-span-2 sm:col-span-1 sm:row-span-1 md:col-span-1 md:row-span-2 lg:col-span-1 lg:row-span-2',
    4: 'row-span-2 sm:col-span-1 sm:row-span-1 md:col-span-1 md:row-span-1 lg:col-span-2 lg:row-span-1',
    5: 'row-span-2 sm:col-span-1 sm:row-span-1 md:col-span-2 md:row-span-1 lg:col-span-1 lg:row-span-1',
  };
  return base[position] ?? 'col-span-1 row-span-2';
}
---

<section id="about" class="py-14 px-5 md:py-20 md:px-8 lg:py-24 lg:px-12">
  <div class="max-w-7xl mx-auto space-y-8" data-animate-container>
    <SectionHeader
      eyebrow="Sobre nosotros"
      title={COPY_NEON.aboutTitle}
      sub={COPY_NEON.aboutBody}
      data-animate="fade-up"
    />

    <!-- BENTO GRID — 6 items -->
    <div class="grid sm:grid-cols-2 auto-rows-[120px] gap-2 mt-7 md:grid-cols-3 md:auto-rows-[160px] md:gap-3 lg:grid-cols-4 lg:auto-rows-[180px] lg:gap-4">
      {ABOUT_GALLERY.map((item, index) => {
        const gridClasses = getGridClasses(item.gridPosition);
        if (item.type === 'video') {
          return (
            <a
              href={`https://res.cloudinary.com/${PUBLIC_CLOUDINARY_CLOUD_NAME}/video/upload/${item.publicId}.mp4`}
              data-lightbox="about-gallery"
              data-type="video"
              class={`block overflow-hidden rounded-2xl border border-line hover:border-accent-2 transition-all duration-300 hover:shadow-[0_0_25px_rgba(0,229,255,0.2)] group relative w-full h-full bg-gradient-to-br from-bg-2 via-bg-3 to-bg-2 ${gridClasses}`}
              data-animate="scale-in"
              data-animate-delay={String(Math.min(index + 1, 8))}
            >
              {/* Aesthetic Card Base (Visible if image fails or before load) */}
              <div class="absolute inset-0 flex flex-col justify-between p-4 sm:p-5 z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,45,135,0.15),transparent_70%)]">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xxs tracking-wider uppercase text-accent bg-accent/10 border border-accent/30 px-2 py-0.5 rounded-full">
                    EN VIVO
                  </span>
                  <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse" />
                </div>
                <div>
                  <span class="font-display font-medium text-base sm:text-lg text-fg tracking-wide block group-hover:text-accent-2 transition-colors">
                    {item.alt}
                  </span>
                  <span class="font-mono text-xxs tracking-widest uppercase text-muted mt-0.5 block">
                    AMBIENTE NOCTURNO · LA LOCURA
                  </span>
                </div>
              </div>

              {hasCloudinary && (
                <CldImage
                  src={item.posterPublicId ?? item.publicId}
                  alt={item.alt}
                  width={600}
                  height={800}
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 z-10"
                  onerror="this.style.display='none'"
                />
              )}
              <div class="absolute inset-0 flex items-center justify-center bg-black/30 transition-opacity duration-300 group-hover:bg-black/15 z-20 pointer-events-none">
                <div class="w-12 h-12 rounded-full bg-accent flex items-center justify-center shadow-[0_0_20px_rgba(255,45,135,0.5)] transition-transform duration-200 group-hover:scale-110">
                  <svg class="w-5 h-5 text-bg ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </a>
          );
        }
        return (
          <a
            href={`https://res.cloudinary.com/${PUBLIC_CLOUDINARY_CLOUD_NAME}/image/upload/q_auto,f_auto,w_1600/${item.publicId}`}
            data-lightbox="about-gallery"
            data-type="image"
            class={`block overflow-hidden rounded-2xl border border-line hover:border-accent-2 transition-all duration-300 hover:shadow-[0_0_25px_rgba(0,229,255,0.2)] group relative w-full h-full bg-gradient-to-br from-bg-2 via-bg-3 to-bg-2 ${gridClasses}`}
            data-animate="scale-in"
            data-animate-delay={String(Math.min(index + 1, 8))}
          >
            {/* Aesthetic Card Base (Visible if image fails or before load) */}
            <div class="absolute inset-0 flex flex-col justify-between p-4 sm:p-5 z-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(0,229,255,0.12),transparent_70%)]">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xxs tracking-wider uppercase text-accent-2 bg-accent-2/10 border border-accent-2/30 px-2 py-0.5 rounded-full">
                  ESPACIO #{index + 1}
                </span>
                <span class="font-mono text-xxs tracking-wider uppercase text-fg-dim/60">
                  VILLAVICENCIO
                </span>
              </div>
              <div>
                <span class="font-display font-medium text-base sm:text-lg text-fg tracking-wide block group-hover:text-accent-2 transition-colors">
                  {item.alt}
                </span>
                <span class="font-mono text-xxs tracking-widest uppercase text-muted mt-0.5 block">
                  PARCHE DE BARRIO · RUMBA
                </span>
              </div>
            </div>

            {hasCloudinary && (
              <CldImage
                src={item.publicId}
                alt={item.alt}
                width={800}
                height={600}
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 z-10"
                onerror="this.style.display='none'"
              />
            )}
          </a>
        );
      })}
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-3 border-y border-line py-4 md:py-6 lg:py-8 my-6" data-animate-container>
      {stats.map((s, i) => (
        <div
          class={`py-4 px-2.5 text-center ${i < stats.length - 1 ? 'border-r border-line' : ''}`}
          data-animate="fade-up"
          data-animate-delay={String(Math.min(i + 1, 8))}
        >
          <div 
            class="font-display text-4xl font-normal text-accent tracking-wider leading-none md:text-5xl lg:text-6xl text-glow-subtle"
            data-animate-counter
            data-counter-target={s.n}
            data-counter-prefix={s.n.startsWith('+') ? '+' : ''}
          >
            {s.n}
          </div>
          <div class="font-mono text-xxs tracking-wider uppercase text-muted mt-2 md:text-xs">
            {s.l}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Deferred GLightbox loader — eliminates render-blocking CSS and unused initial JS
  const galleryLinks = document.querySelectorAll('[data-lightbox="about-gallery"]');
  if (galleryLinks.length) {
    let glightboxInstance: any = null;
    const initLightbox = async () => {
      if (glightboxInstance) return;
      if (!document.querySelector('link[href="/css/glightbox.min.css"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/css/glightbox.min.css';
        document.head.appendChild(link);
      }
      const { default: GLightbox } = await import('glightbox');
      glightboxInstance = GLightbox({
        selector: '[data-lightbox="about-gallery"]',
        touchNavigation: true,
        loop: true,
        zoomable: true,
        draggable: true,
        openEffect: 'fade',
        closeEffect: 'fade',
        autoplayVideos: true,
      });
    };

    galleryLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        if (!glightboxInstance) {
          e.preventDefault();
          initLightbox().then(() => {
            (link as HTMLElement).click();
          });
        }
      }, { once: true });
      link.addEventListener('mouseenter', initLightbox, { once: true, passive: true });
      link.addEventListener('touchstart', initLightbox, { once: true, passive: true });
    });

    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(initLightbox, 3000));
    } else {
      setTimeout(initLightbox, 3500);
    }
  }

  // Counter animation for stats
  (function() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (prefersReducedMotion.matches) return;

    const counters = document.querySelectorAll<HTMLElement>('[data-animate-counter]');
    if (!counters.length) return;

    const duration = 1500; // 1.5 seconds

    function easeOutExpo(t: number): number {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
    }

    function animateCounter(el: HTMLElement) {
      const targetValue = parseInt(el.dataset.counterTarget?.replace(/\D/g, '') || '0', 10);
      const prefix = el.dataset.counterPrefix || '';
      const isYear = targetValue >= 1900 && targetValue <= 2100;
      const startVal = isYear ? 2000 : 0;
      const startTime = performance.now();

      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = easeOutExpo(progress);
        const current = Math.round(startVal + eased * (targetValue - startVal));
        
        el.textContent = isYear ? String(current) : prefix + current.toLocaleString('es-CO');

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          el.textContent = isYear ? String(targetValue) : prefix + targetValue.toLocaleString('es-CO');
        }
      }

      requestAnimationFrame(update);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            animateCounter(el);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );

    counters.forEach((counter) => {
      observer.observe(counter);
    });
  })();
</script>
