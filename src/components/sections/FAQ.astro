---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<section
  id="preguntas"
  class="relative bg-paper text-ink py-20 md:py-28 lg:py-36 px-4 sm:px-6 lg:px-12 border-b border-line-light/50"
  aria-label="Preguntas frecuentes"
>
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Header & WhatsApp Help CTA -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span class="font-body text-xs md:text-sm font-semibold tracking-[0.2em] text-accent uppercase">
              {SITE_CONFIG.faq.eyebrow}
            </span>
          </div>
          <h2 class="font-display text-4xl sm:text-5xl md:text-6xl tracking-tight text-ink leading-[0.95] uppercase mb-4 text-balance">
            {SITE_CONFIG.faq.title}
          </h2>
          <p class="font-body text-base md:text-lg text-ink-muted leading-relaxed text-pretty">
            {SITE_CONFIG.faq.description}
          </p>
        </div>

        <!-- Extra Help Card -->
        <div class="bg-paper-2 p-6 rounded-sm border border-line-light/60 space-y-3">
          <span class="font-display text-xs tracking-wider uppercase text-primary block">
            {SITE_CONFIG.faq.extraHelp.title}
          </span>
          <p class="font-body text-sm text-ink-muted">
            {SITE_CONFIG.faq.extraHelp.text}
          </p>
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center bg-dark text-paper font-display text-sm uppercase tracking-wider px-5 py-2.5 rounded-sm hover:bg-surface-raised active:scale-95 transition-all"
          >
            {SITE_CONFIG.faq.extraHelp.cta} →
          </a>
        </div>
      </div>

      <!-- Right Column: Accessible FAQ Accordions -->
      <div class="lg:col-span-7 space-y-3" role="region" aria-label="Preguntas frecuentes de La Locura Bar">
        {SITE_CONFIG.faq.items.map((item, index) => (
          <details
            class="group bg-paper-2/60 border border-line-light/60 rounded-sm transition-all duration-200 open:bg-paper-2 open:border-line-light overflow-hidden"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-lg sm:text-xl text-ink uppercase tracking-wide select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-primary [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3">
                <span class="text-xs text-accent font-body font-semibold">0{index + 1}.</span>
                <span>{item.question}</span>
              </span>
              <span class="shrink-0 w-6 h-6 flex items-center justify-center text-ink-muted group-open:rotate-45 transition-transform duration-200 font-display text-xl" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="px-5 pb-5 pt-1 text-ink-muted font-body text-sm sm:text-base leading-relaxed border-t border-line-light/30">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
