---
import { SITE_CONFIG, MENU_PRODUCTS } from '../../data/siteConfig';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { formatCOP, WHATSAPP_PHONE } from '../../utils/whatsapp';

const categories = SITE_CONFIG.carta.categories;
---

<section
  id="calculadora"
  class="relative bg-[#0D0B0C] text-white py-16 sm:py-20 lg:py-28 px-4 sm:px-6 lg:px-12 border-b border-white/10 overflow-hidden select-none"
  aria-label="Calculadora de cuenta"
>
  <!-- Background Ambient Glow & Bar Table Gradients -->
  <div class="absolute inset-0 bg-radial from-white/[0.03] via-transparent to-transparent pointer-events-none" />
  <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-black/80 via-black/40 to-transparent pointer-events-none" />

  <!-- Top-Right Graffiti Stamp "LA NOCHE ES DEL BARRIO" with Crown -->
  <div class="absolute top-4 sm:top-8 right-3 sm:right-8 lg:right-16 z-0 pointer-events-none select-none opacity-85 lg:opacity-95">
    <img
      src="/images/v2/calc_graffiti.webp"
      alt=""
      width="350"
      height="155"
      class="w-36 sm:w-48 md:w-60 lg:w-72 xl:w-80 h-auto object-contain transform rotate-1"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Left Side Ambient Metal Cup with Graffiti -->
  <div class="hidden xl:block absolute left-0 top-1/2 -translate-y-1/2 z-0 pointer-events-none select-none opacity-30">
    <img
      src="/images/v2/calc_left_cup.webp"
      alt=""
      width="100"
      height="450"
      class="w-20 lg:w-28 h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Right Side Ambient Bottle with Water Droplets -->
  <div class="hidden xl:block absolute -right-2 top-1/3 z-0 pointer-events-none select-none opacity-35">
    <img
      src="/images/v2/calc_aguila_ambient.webp"
      alt=""
      width="286"
      height="1024"
      class="w-40 lg:w-48 h-auto object-contain"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="max-w-2xl mb-8 sm:mb-10 lg:mb-12">
      <!-- Eyebrow -->
      <span class="block font-body text-xs sm:text-sm font-bold tracking-[0.22em] text-secondary uppercase mb-2 sm:mb-3">
        {SITE_CONFIG.calculadora.eyebrow}
      </span>

      <!-- Headline with Pink Brush Underline -->
      <h2 class="font-display tracking-tight leading-[0.88] uppercase select-none text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] text-white">
        ¿CUÁNTO SALE{' '}
        <span class="text-primary inline-block relative whitespace-nowrap">
          EL PARCHE?
          <img
            src="/images/v2/esencia_underline.webp"
            alt=""
            width="480"
            height="53"
            class="absolute -bottom-1 sm:-bottom-2 left-0 w-full h-auto object-contain pointer-events-none select-none"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
        </span>
      </h2>

      <!-- Description -->
      <p class="font-body text-sm sm:text-base text-white/75 mt-3 max-w-xl leading-relaxed">
        {SITE_CONFIG.calculadora.description}
      </p>
    </div>

    <!-- Main Grid: Products selector (left 7 cols) & Receipt ticket (right 5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-start">
      <!-- Left: Products with category tabs -->
      <div class="lg:col-span-7">
        <!-- Category Filter Cards (Pills with Icon + Title + Subtitle) -->
        <div
          class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 mb-6"
          role="tablist"
          aria-label="Filtrar por categoría"
        >
          {categories.map((cat, idx) => {
            const isActive = idx === 0;
            return (
              <Button
                type="button"
                variant="calc-tab"
                role="tab"
                id={`calc-tab-btn-${cat.id}`}
                data-calc-filter={cat.id}
                aria-selected={isActive ? 'true' : 'false'}
                tabindex={isActive ? 0 : -1}
              >
                <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg flex items-center justify-center shrink-0 transition-colors bg-white/5 text-secondary group-hover:bg-white/10 group-aria-selected:bg-dark/15 group-aria-selected:text-dark group-aria-selected:group-hover:bg-dark/15">
                  <Icon
                    name={cat.icon || 'beer'}
                    size="sm"
                    class="transition-colors text-secondary group-aria-selected:text-dark"
                  />
                </div>
                <div class="min-w-0">
                  <span class="block font-display text-xs sm:text-sm uppercase tracking-wider leading-tight truncate">
                    {cat.label}
                  </span>
                  <span class="block font-body text-[10px] sm:text-[11px] truncate transition-colors text-white/60 group-hover:text-white/85 group-aria-selected:text-dark/80 group-aria-selected:font-medium">
                    {cat.sublabel}
                  </span>
                </div>
              </Button>
            );
          })}
        </div>

        <!-- Products List -->
        <div class="space-y-2.5 sm:space-y-3" id="calc-products-list">
          {MENU_PRODUCTS.map((prod) => {
            const isDefaultCat = prod.category === 'personal';
            return (
              <div
                class={`calc-product-item ${isDefaultCat ? 'flex' : 'hidden'} items-center justify-between p-2.5 sm:p-3.5 rounded-xl bg-[#141414] border border-white/10 hover:border-white/20 transition-all gap-2 sm:gap-4 group`}
                data-category={prod.category}
                data-id={prod.id}
                data-name={prod.name}
                data-presentation={prod.presentation}
                data-price={prod.price}
              >
                {/* Product Thumbnail */}
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg overflow-hidden bg-black/40 border border-white/10 flex items-center justify-center shrink-0">
                  {prod.image ? (
                    <img
                      src={prod.image}
                      alt={prod.name}
                      width="480"
                      height="480"
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : prod.bottleImage ? (
                    <img
                      src={prod.bottleImage}
                      alt=""
                      width="30"
                      height="64"
                      class="max-h-full max-w-full object-contain filter drop-shadow-xs"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <Icon name="bottle" size="sm" class="text-white/60" />
                  )}
                </div>

                {/* Product Name & Presentation */}
                <div class="flex-1 min-w-0 pr-1">
                  <h3 class="font-display text-base sm:text-lg text-white uppercase tracking-tight truncate leading-tight">
                    {prod.name}
                  </h3>
                  <span class="font-body text-xs text-white/75 block">
                    {prod.presentation}
                  </span>
                </div>

                {/* Price in Gold/Amber */}
                <div class="shrink-0 text-right px-1 sm:px-2">
                  <span class="font-display text-base sm:text-lg text-secondary tabular-nums font-bold">
                    {formatCOP(prod.price)}
                  </span>
                </div>

                {/* Stepper Controls */}
                <div class="flex items-center gap-1.5 shrink-0">
                  <Button
                    type="button"
                    variant="stepper"
                    size="none"
                    data-action="decrement"
                    class="w-8 h-8 sm:w-9 sm:h-9 disabled:opacity-45 disabled:pointer-events-none"
                    aria-label={`Quitar uno de ${prod.name}`}
                    disabled
                  >
                    <Icon name="minus" size="sm" class="text-white stroke-[2.5] shrink-0" />
                  </Button>
                  <span
                    data-qty-display
                    class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-[#0A0809] border border-white/15 flex items-center justify-center font-body font-extrabold text-sm sm:text-base text-white tabular-nums"
                    aria-live="polite"
                    aria-label={`Cantidad de ${prod.name}: 0`}
                  >
                    0
                  </span>
                  <Button
                    type="button"
                    variant="primary"
                    size="none"
                    data-action="increment"
                    class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg justify-center shadow-xs"
                    aria-label={`Agregar uno de ${prod.name}`}
                  >
                    <Icon name="plus" size="sm" class="text-dark stroke-[2.75] shrink-0" />
                  </Button>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Right: Ticket / Resumen Estimado ("TU CUENTA") -->
      <div class="lg:col-span-5 lg:sticky lg:top-24">
        <div class="ticket-container ticket-serrated relative text-[#1C1815] shadow-2xl overflow-hidden bg-[#F4ECE1] pt-4 pb-4">
          <div class="p-5 sm:p-7 lg:p-8">
            {/* Ticket Brand & Header */}
            <div class="text-center pb-4">
              <img
                src="/images/logo-transparent.webp"
                alt="La Locura Bar"
                width="220"
                height="170"
                class="h-14 sm:h-16 w-auto mx-auto object-contain mb-2 select-none drop-shadow-[0_1px_3px_rgba(23,19,21,0.45)]"
                loading="lazy"
                decoding="async"
              />
              <h3 class="font-display text-3xl sm:text-4xl text-[#121212] uppercase tracking-tight leading-none mb-0.5">
                TU CUENTA
              </h3>
              <span class="font-body text-xs font-bold tracking-[0.2em] text-[#5F554A] uppercase block">
                RESUMEN ESTIMADO
              </span>
            </div>

            {/* Table Column Headers */}
            <div class="flex items-center justify-between text-[11px] font-bold text-[#5F554A] uppercase tracking-wider py-2 border-b border-dashed border-[#C5BBAE]/80">
              <span class="flex-1">PRODUCTO</span>
              <span class="w-14 text-center">CANT.</span>
              <span class="w-24 text-right">SUBTOTAL</span>
            </div>

            {/* Empty state notice */}
            <div id="ticket-empty-msg" class="py-10 text-center text-[#5F554A] font-body text-sm">
              <Icon name="calculator" size="md" class="mx-auto mb-2 opacity-50 text-[#5F554A]" />
              Agrega bebidas para ver tu cuenta.
            </div>

            {/* Active items list */}
            <div id="ticket-items-container" class="py-2 space-y-2 max-h-[260px] overflow-y-auto hidden scrollbar-none">
              <!-- Dynamic rows injected via JavaScript -->
            </div>

            {/* Total Row */}
            <div class="pt-4 border-t-2 border-dashed border-[#C5BBAE]/80 mt-2">
              <div class="flex items-baseline justify-between mb-5">
                <span class="font-display text-base sm:text-lg tracking-wider uppercase text-[#1C1815] font-bold">
                  TOTAL ESTIMADO
                </span>
                <span id="ticket-total-display" class="font-display text-3xl sm:text-4xl lg:text-5xl text-accent tabular-nums font-black leading-none drop-shadow-xs">
                  $0
                </span>
              </div>

              <!-- Action buttons -->
              <div class="space-y-2.5">
                <!-- WhatsApp Share Button -->
                <a
                  id="btn-whatsapp-share"
                  aria-disabled="true"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2.5 bg-[#15803D] hover:bg-[#166534] text-white font-display text-sm sm:text-base uppercase tracking-wider py-3.5 px-4 rounded-xl font-bold shadow-md hover:shadow-lg active:scale-95 transition-all text-center pointer-events-none opacity-45"
                >
                  <Icon name="whatsapp" size="md" class="text-white shrink-0" />
                  <span>COMPARTIR ESTIMADO POR WHATSAPP</span>
                  <Icon name="arrow-right" size="sm" class="text-white shrink-0" />
                </a>

                <!-- Clear Account Button -->
                <Button
                  type="button"
                  variant="ghost-light"
                  size="none"
                  id="btn-clear-calc"
                  class="w-full py-2.5 px-4 text-xs sm:text-sm disabled:opacity-0 disabled:pointer-events-none"
                  disabled
                >
                  <Icon name="trash" size="sm" class="shrink-0" />
                  <span>LIMPIAR CUENTA</span>
                </Button>
              </div>

              <!-- Disclaimer note & Crown mark -->
              <div class="relative flex items-center justify-center mt-5 pt-3 border-t border-[#D5CABE]/50">
                <img
                  src="/images/v2/esencia_crown.webp"
                  alt=""
                  width="127"
                  height="138"
                  class="w-6 h-auto object-contain opacity-60 absolute left-0"
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
                <p class="font-body text-[10px] sm:text-[11px] text-[#5F554A] text-center leading-snug px-8">
                  Valores sujetos a la carta vigente. Esta es una estimación, no un pedido.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ whatsappPhone: WHATSAPP_PHONE }}>
  function setupCalculator() {
    const state = new Map(); // id -> { name, presentation, price, qty }

    const productsList = document.getElementById('calc-products-list');
    const emptyMsg = document.getElementById('ticket-empty-msg');
    const itemsContainer = document.getElementById('ticket-items-container');
    const totalDisplay = document.getElementById('ticket-total-display');
    const shareBtn = document.getElementById('btn-whatsapp-share');
    const clearBtn = document.getElementById('btn-clear-calc');

    function formatCOPClient(amount) {
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        maximumFractionDigits: 0,
      }).format(amount);
    }

    function updateTicketUI() {
      let total = 0;
      const activeItems = [];

      state.forEach((item) => {
        if (item.qty > 0) {
          const subtotal = item.qty * item.price;
          total += subtotal;
          activeItems.push({ ...item, subtotal });
        }
      });

      if (totalDisplay) {
        totalDisplay.textContent = formatCOPClient(total);
      }

      if (activeItems.length === 0) {
        emptyMsg?.classList.remove('hidden');
        itemsContainer?.classList.add('hidden');
        if (itemsContainer) itemsContainer.innerHTML = '';
        if (shareBtn) {
          shareBtn.classList.add('pointer-events-none', 'opacity-45');
          shareBtn.setAttribute('aria-disabled', 'true');
          shareBtn.removeAttribute('href');
        }
        if (clearBtn) {
          clearBtn.disabled = true;
        }
      } else {
        emptyMsg?.classList.add('hidden');
        itemsContainer?.classList.remove('hidden');
        if (clearBtn) {
          clearBtn.disabled = false;
        }

        // Render rows matching the table format in the mockup
        if (itemsContainer) {
          itemsContainer.innerHTML = activeItems
            .map(
              (it) => `
              <div class="flex items-center justify-between text-xs py-1.5 border-b border-[#C5BBAE]/40 font-body">
                <span class="font-bold text-[#1C1815] truncate flex-1 pr-2">
                  ${it.name} <span class="text-[#5F554A] font-normal text-[11px]">(${it.presentation})</span>
                </span>
                <span class="w-14 text-center font-bold text-[#1C1815]">
                  ${it.qty}
                </span>
                <span class="w-24 text-right font-bold text-[#1C1815] tabular-nums">
                  ${formatCOPClient(it.subtotal)}
                </span>
              </div>
            `
            )
            .join('');
        }

        // Build authentic Colombian WhatsApp order message
        if (shareBtn) {
          shareBtn.classList.remove('pointer-events-none', 'opacity-45');
          shareBtn.removeAttribute('aria-disabled');
          const lines = activeItems
            .map((it) => `• ${it.qty}x ${it.name} (${it.presentation}) — ${formatCOPClient(it.subtotal)}`)
            .join('\n');

          const message = [
            '¡Hola La Locura Bar! 👋🍻',
            'Estuve armando mi cuenta en la web para el parche y me gustaría pedir / consultar:',
            '',
            lines,
            '',
            `👉 Total estimado: ${formatCOPClient(total)}`,
            '',
            '¿Tienen mesa disponible para hoy?',
          ].join('\n');

          shareBtn.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(message)}`;
        }
      }
    }

    // Handle plus and minus clicks
    productsList?.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const actionBtn = target.closest('button[data-action]');
      if (!actionBtn) return;

      const action = actionBtn.getAttribute('data-action');
      const card = actionBtn.closest('.calc-product-item');
      if (!card) return;

      const id = card.getAttribute('data-id');
      const name = card.getAttribute('data-name');
      const presentation = card.getAttribute('data-presentation');
      const price = Number(card.getAttribute('data-price') || 0);
      const qtyDisplay = card.querySelector('[data-qty-display]');
      const decBtn = card.querySelector('button[data-action="decrement"]');

      if (!id || !name) return;

      let current = state.get(id) || { name, presentation, price, qty: 0 };

      if (action === 'increment') {
        current.qty += 1;
      } else if (action === 'decrement' && current.qty > 0) {
        current.qty -= 1;
      }

      state.set(id, current);

      // Update card controls
      if (qtyDisplay) {
        qtyDisplay.textContent = String(current.qty);
        qtyDisplay.setAttribute('aria-label', `Cantidad de ${name}: ${current.qty}`);
      }
      if (decBtn) {
        decBtn.disabled = current.qty === 0;
      }

      updateTicketUI();
    });

    // Handle clear
    clearBtn?.addEventListener('click', () => {
      state.clear();
      const qtyDisplays = productsList?.querySelectorAll('[data-qty-display]');
      const decBtns = productsList?.querySelectorAll('button[data-action="decrement"]');
      qtyDisplays?.forEach((el) => (el.textContent = '0'));
      decBtns?.forEach((btn) => (btn.disabled = true));
      updateTicketUI();
    });

    // Handle category filtering
    const filterBtns = Array.from(document.querySelectorAll('[data-calc-filter]'));
    const productCards = document.querySelectorAll('.calc-product-item');

    function activateFilter(targetBtn) {
      const filter = targetBtn.getAttribute('data-calc-filter');
      if (!filter) return;

      filterBtns.forEach((b) => {
        const isCurrent = b === targetBtn;
        b.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        b.setAttribute('tabindex', isCurrent ? '0' : '-1');
      });

      productCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (cat === filter) {
          card.classList.remove('hidden');
          card.classList.add('flex');
        } else {
          card.classList.add('hidden');
          card.classList.remove('flex');
        }
      });
    }

    filterBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => activateFilter(btn));

      btn.addEventListener('keydown', (e) => {
        let nextIndex = -1;
        if (e.key === 'ArrowRight') nextIndex = (index + 1) % filterBtns.length;
        else if (e.key === 'ArrowLeft') nextIndex = (index - 1 + filterBtns.length) % filterBtns.length;
        else if (e.key === 'Home') nextIndex = 0;
        else if (e.key === 'End') nextIndex = filterBtns.length - 1;

        if (nextIndex !== -1) {
          e.preventDefault();
          const nextBtn = filterBtns[nextIndex];
          activateFilter(nextBtn);
          nextBtn.focus();
        }
      });
    });
  }

  // Initialize on script execution and on page swaps
  setupCalculator();
  document.addEventListener('astro:page-load', setupCalculator);
</script>
