---
import { SITE_CONFIG, MENU_PRODUCTS } from '../../data/siteConfig';
import { formatCOP, WHATSAPP_PHONE } from '../../utils/whatsapp';

const categories = SITE_CONFIG.carta.categories;
---

<section
  id="calculadora"
  class="relative bg-background text-text py-20 md:py-28 lg:py-36 px-4 sm:px-6 lg:px-12 border-b border-line/40"
  aria-label="Calculadora de cuenta"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl mb-12 lg:mb-16">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span class="font-body text-xs md:text-sm font-semibold tracking-[0.2em] text-accent uppercase">
          {SITE_CONFIG.calculadora.eyebrow}
        </span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight text-text leading-[0.95] uppercase mb-4 text-balance">
        {SITE_CONFIG.calculadora.title}
      </h2>
      <p class="font-body text-base md:text-lg text-muted leading-relaxed text-pretty">
        {SITE_CONFIG.calculadora.description}
      </p>
    </div>

    <!-- Main Grid: Products selector (left 7 cols) & Receipt ticket (right 5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left: Products with category tabs -->
      <div class="lg:col-span-7">
        <!-- Category Filter Pills -->
        <div class="flex overflow-x-auto gap-2 pb-3 mb-6 scrollbar-none" role="tablist" aria-label="Filtrar por categoría">
          <button
            type="button"
            data-calc-filter="all"
            class="px-4 py-2 rounded-xs font-display text-sm uppercase tracking-wider bg-surface-raised text-text border border-line active-filter cursor-pointer"
          >
            Todas
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-calc-filter={cat.id}
              class="px-4 py-2 rounded-xs font-display text-sm uppercase tracking-wider bg-surface text-muted border border-line/40 hover:text-text hover:border-line cursor-pointer"
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Products List -->
        <div class="space-y-3" id="calc-products-list">
          {MENU_PRODUCTS.map((prod) => (
            <div
              class="calc-product-item flex items-center justify-between p-4 rounded-sm bg-surface/80 border border-line/40 hover:border-line transition-all"
              data-category={prod.category}
              data-id={prod.id}
              data-name={prod.name}
              data-presentation={prod.presentation}
              data-price={prod.price}
            >
              <div class="pr-3 flex-1 min-w-0">
                <div class="flex items-baseline gap-2">
                  <h3 class="font-display text-lg sm:text-xl text-text uppercase truncate">
                    {prod.name}
                  </h3>
                  <span class="text-xs text-muted font-body shrink-0">
                    {prod.presentation}
                  </span>
                </div>
                <span class="font-display text-base text-secondary tabular-nums font-bold">
                  {formatCOP(prod.price)}
                </span>
              </div>

              <!-- Quantity Controls -->
              <div class="flex items-center gap-2 shrink-0 bg-background/80 p-1 rounded-sm border border-line/60">
                <button
                  type="button"
                  data-action="decrement"
                  class="w-8 h-8 flex items-center justify-center font-display text-lg text-muted hover:text-text hover:bg-surface rounded-xs disabled:opacity-30 disabled:pointer-events-none cursor-pointer transition-colors"
                  aria-label={`Reducir cantidad de ${prod.name}`}
                  disabled
                >
                  −
                </button>
                <span
                  data-qty-display
                  class="w-7 text-center font-display text-lg text-text tabular-nums"
                  aria-live="polite"
                  aria-label={`Cantidad de ${prod.name}: 0`}
                >
                  0
                </span>
                <button
                  type="button"
                  data-action="increment"
                  class="w-8 h-8 flex items-center justify-center font-display text-lg text-muted hover:text-text hover:bg-surface rounded-xs cursor-pointer transition-colors"
                  aria-label={`Aumentar cantidad de ${prod.name}`}
                >
                  +
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Ticket / Resumen Estimado -->
      <div class="lg:col-span-5 lg:sticky lg:top-24">
        <div class="bg-paper text-ink p-6 sm:p-8 rounded-sm shadow-xl border border-line-light relative overflow-hidden">
          <!-- Ticket Header -->
          <div class="text-center pb-5 border-b-2 border-dashed border-line-light/80">
            <span class="font-display text-xs tracking-[0.25em] text-ink-muted uppercase block mb-1">
              {SITE_CONFIG.calculadora.ticketBrand}
            </span>
            <h3 class="font-display text-3xl text-ink uppercase tracking-tight">
              {SITE_CONFIG.calculadora.ticketTitle}
            </h3>
            <span class="font-display text-xs tracking-widest text-primary uppercase">
              {SITE_CONFIG.calculadora.ticketSubtitle}
            </span>
          </div>

          <!-- Empty state notice -->
          <div id="ticket-empty-msg" class="py-12 text-center text-ink-muted font-body text-sm">
            {SITE_CONFIG.calculadora.emptyState}
          </div>

          <!-- Active items list -->
          <div id="ticket-items-container" class="py-4 space-y-3 max-h-[300px] overflow-y-auto hidden">
            <!-- Dynamic rows injected here -->
          </div>

          <!-- Ticket Footer / Total -->
          <div class="pt-5 border-t-2 border-dashed border-line-light/80 mt-4">
            <div class="flex items-baseline justify-between mb-6">
              <span class="font-display text-sm tracking-wider uppercase text-ink-muted">
                {SITE_CONFIG.calculadora.totalLabel}
              </span>
              <span id="ticket-total-display" class="font-display text-3xl sm:text-4xl text-ink tabular-nums font-bold">
                $0
              </span>
            </div>

            <!-- Action buttons -->
            <div class="space-y-3">
              <a
                id="btn-whatsapp-share"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center bg-secondary text-dark font-display text-base uppercase tracking-wider py-3.5 px-4 rounded-sm font-semibold hover:bg-gold-soft active:scale-95 transition-all text-center pointer-events-none opacity-40 shadow-xs"
              >
                {SITE_CONFIG.calculadora.ctaShare}
              </a>

              <button
                type="button"
                id="btn-clear-calc"
                class="w-full text-center py-2 text-xs font-display uppercase tracking-wider text-ink-muted hover:text-ink disabled:opacity-0 disabled:pointer-events-none transition-all cursor-pointer"
                disabled
              >
                {SITE_CONFIG.calculadora.ctaClear}
              </button>
            </div>

            <!-- Disclaimer note -->
            <p class="font-body text-xxs text-ink-muted text-center mt-5 leading-normal">
              {SITE_CONFIG.calculadora.disclaimer}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ whatsappPhone: WHATSAPP_PHONE }}>
  const state = new Map(); // id -> { name, presentation, price, qty }

  const productsList = document.getElementById('calc-products-list');
  const emptyMsg = document.getElementById('ticket-empty-msg');
  const itemsContainer = document.getElementById('ticket-items-container');
  const totalDisplay = document.getElementById('ticket-total-display');
  const shareBtn = document.getElementById('btn-whatsapp-share');
  const clearBtn = document.getElementById('btn-clear-calc');

  function formatCOPClient(amount) {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      maximumFractionDigits: 0,
    }).format(amount);
  }

  function updateTicketUI() {
    let total = 0;
    const activeItems = [];

    state.forEach((item) => {
      if (item.qty > 0) {
        const subtotal = item.qty * item.price;
        total += subtotal;
        activeItems.push({ ...item, subtotal });
      }
    });

    if (totalDisplay) {
      totalDisplay.textContent = formatCOPClient(total);
    }

    if (activeItems.length === 0) {
      emptyMsg?.classList.remove('hidden');
      itemsContainer?.classList.add('hidden');
      if (itemsContainer) itemsContainer.innerHTML = '';
      if (shareBtn) {
        shareBtn.classList.add('pointer-events-none', 'opacity-40');
        shareBtn.removeAttribute('href');
      }
      if (clearBtn) {
        clearBtn.disabled = true;
      }
    } else {
      emptyMsg?.classList.add('hidden');
      itemsContainer?.classList.remove('hidden');
      if (clearBtn) {
        clearBtn.disabled = false;
      }

      // Render rows
      if (itemsContainer) {
        itemsContainer.innerHTML = activeItems
          .map(
            (it) => `
            <div class="flex items-center justify-between text-xs py-1 border-b border-line-light/30">
              <span class="font-body text-ink font-medium truncate pr-2">
                ${it.qty} × ${it.name} <span class="text-ink-muted">(${it.presentation})</span>
              </span>
              <span class="font-display text-sm text-ink tabular-nums font-bold shrink-0">
                ${formatCOPClient(it.subtotal)}
              </span>
            </div>
          `
          )
          .join('');
      }

      // Prepare WhatsApp link
      if (shareBtn) {
        shareBtn.classList.remove('pointer-events-none', 'opacity-40');
        const lines = activeItems
          .map((it) => `${it.qty} × ${it.name} (${it.presentation}) — ${formatCOPClient(it.subtotal)}`)
          .join('\n');

        const message = [
          'Hola, quiero compartir este estimado de La Locura Bar:',
          '',
          lines,
          '',
          `Total estimado: ${formatCOPClient(total)}`,
          '',
          'Este cálculo es orientativo y no es un pedido. Los valores pueden cambiar según la carta vigente.',
        ].join('\n');

        shareBtn.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(message)}`;
      }
    }
  }

  // Handle plus and minus clicks
  productsList?.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;

    const actionBtn = target.closest('button[data-action]');
    if (!actionBtn) return;

    const action = actionBtn.getAttribute('data-action');
    const card = actionBtn.closest('.calc-product-item');
    if (!card) return;

    const id = card.getAttribute('data-id');
    const name = card.getAttribute('data-name');
    const presentation = card.getAttribute('data-presentation');
    const price = Number(card.getAttribute('data-price') || 0);
    const qtyDisplay = card.querySelector('[data-qty-display]');
    const decBtn = card.querySelector('button[data-action="decrement"]');

    if (!id || !name) return;

    let current = state.get(id) || { name, presentation, price, qty: 0 };

    if (action === 'increment') {
      current.qty += 1;
    } else if (action === 'decrement' && current.qty > 0) {
      current.qty -= 1;
    }

    state.set(id, current);

    // Update card controls
    if (qtyDisplay) {
      qtyDisplay.textContent = String(current.qty);
      qtyDisplay.setAttribute('aria-label', `Cantidad de ${name}: ${current.qty}`);
    }
    if (decBtn) {
      decBtn.disabled = current.qty === 0;
    }

    updateTicketUI();
  });

  // Handle clear
  clearBtn?.addEventListener('click', () => {
    state.clear();
    const qtyDisplays = productsList?.querySelectorAll('[data-qty-display]');
    const decBtns = productsList?.querySelectorAll('button[data-action="decrement"]');
    qtyDisplays?.forEach((el) => (el.textContent = '0'));
    decBtns?.forEach((btn) => (btn.disabled = true));
    updateTicketUI();
  });

  // Handle category filtering
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-calc-filter]');
  const productCards = document.querySelectorAll<HTMLElement>('.calc-product-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-calc-filter');
      filterBtns.forEach((b) => {
        const isCurrent = b === btn;
        if (isCurrent) {
          b.classList.add('bg-surface-raised', 'text-text');
          b.classList.remove('bg-surface', 'text-muted');
        } else {
          b.classList.remove('bg-surface-raised', 'text-text');
          b.classList.add('bg-surface', 'text-muted');
        }
      });

      productCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.classList.remove('hidden');
          card.classList.add('flex');
        } else {
          card.classList.add('hidden');
          card.classList.remove('flex');
        }
      });
    });
  });
</script>
