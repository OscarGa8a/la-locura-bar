---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<section
  id="inicio"
  class="relative min-h-[90vh] md:min-h-screen flex items-center pt-24 pb-16 px-4 sm:px-6 lg:px-12 overflow-hidden bg-background"
  aria-label="Inicio"
>
  <!-- Background Image with Responsive picture & gradient overlays -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none">
    <picture>
      <source media="(max-width: 768px)" srcset={SITE_CONFIG.hero.imageMobile} />
      <img
        src={SITE_CONFIG.hero.imageDesktop}
        alt={SITE_CONFIG.hero.imageAlt}
        class="w-full h-full object-cover object-center md:object-right opacity-65 md:opacity-75"
        loading="eager"
        decoding="async"
      />
    </picture>
    <!-- Multi-stop directional overlay for maximum typographic contrast -->
    <div
      class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-background via-background/85 md:via-background/70 to-transparent"
    ></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-background/90 via-transparent to-background"
    ></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-7xl mx-auto w-full">
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-sm bg-surface/80 border border-line/60 backdrop-blur-xs">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-xs md:text-sm font-body font-semibold tracking-[0.2em] text-accent uppercase">
          {SITE_CONFIG.hero.eyebrow}
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight text-text leading-[0.92] uppercase mb-6 text-balance">
        {SITE_CONFIG.hero.title}
      </h1>

      <!-- Description -->
      <p class="font-body text-base sm:text-lg md:text-xl text-muted leading-relaxed mb-8 max-w-xl text-pretty">
        {SITE_CONFIG.hero.description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href={SITE_CONFIG.hero.ctaPrimary.href}
          class="inline-flex items-center justify-center bg-secondary text-dark font-display text-lg tracking-wider uppercase px-8 py-3.5 rounded-sm font-semibold hover:bg-gold-soft active:scale-95 transition-all text-center shadow-lg shadow-secondary/15"
        >
          {SITE_CONFIG.hero.ctaPrimary.label}
        </a>
        <a
          href={SITE_CONFIG.hero.ctaSecondary.href}
          class="inline-flex items-center justify-center bg-surface/80 hover:bg-surface border border-line text-text font-display text-lg tracking-wider uppercase px-8 py-3.5 rounded-sm font-semibold hover:border-text active:scale-95 transition-all text-center backdrop-blur-xs"
        >
          {SITE_CONFIG.hero.ctaSecondary.label}
        </a>
      </div>
    </div>
  </div>
</section>
