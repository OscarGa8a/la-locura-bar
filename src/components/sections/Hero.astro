---
import Icon from "../ui/Icons.astro";
import { COPY_NEON } from "../../data/content";
import Button from "../ui/Button.astro";
---

<!-- ═══════════════════════════════════════════ -->
<!-- UNIFIED RESPONSIVE HERO (Single H1)        -->
<!-- ═══════════════════════════════════════════ -->
<section
  class="relative py-8 px-5 pb-15 md:pt-16 md:pb-20 md:px-8 lg:px-12 lg:pt-20 lg:pb-24 md:min-h-[calc(100dvh-105px)] overflow-hidden"
  style="background: radial-gradient(ellipse at 20% 0%, rgba(255,45,135,0.3) 0%, transparent 60%), radial-gradient(ellipse at 80% 100%, rgba(0,229,255,0.25) 0%, transparent 60%)"
>
  <!-- Grid overlay -->
  <div class="absolute inset-0 opacity-15 bg-grid" />

  <!-- Logo watermark (desktop only) -->
  <img
    src="/images/logo-transparent.png"
    alt=""
    aria-hidden="true"
    width="769"
    height="593"
    class="hidden md:block absolute right-2 top-2 w-80 opacity-30 pointer-events-none select-none lg:w-100"
  />

  <!-- Inner container centered, max-width constrained -->
  <div class="relative w-full max-w-7xl mx-auto">
    <div class="flex flex-col">
      <!-- LIVE ticker -->
      <div
        class="inline-flex gap-1.5 items-center py-1 px-2.5 md:px-3 w-fit border border-accent text-accent font-mono text-xxs md:text-xs tracking-ultra uppercase mb-6 md:mb-8"
      >
        <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-accent animate-pulse" />
        EN VIVO · ABIERTO HOY
      </div>

      <!-- Single SEO H1 — responsive font scale and layout -->
      <h1
        class="font-display font-normal uppercase m-0 leading-none text-fg text-glow flex flex-col md:inline-flex md:flex-row md:items-baseline md:flex-nowrap gap-x-2 md:gap-x-3 lg:gap-x-4"
      >
        <span class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl">LA</span>
        <span class="text-7xl sm:text-7xl md:text-8xl lg:text-9xl text-accent-2 text-glow-cyan">LOCURA</span>
        <span class="text-base sm:text-xl md:text-base lg:text-lg text-fg-dim tracking-ultra mt-2 md:mt-0 md:self-end pb-1 text-shadow-none">
          // BAR EN VILLAVICENCIO
        </span>
      </h1>
    </div>

    <!-- Main content area: subtitle + CTAs left, featured card right on lg -->
    <div
      class="flex flex-col lg:flex-row lg:items-start lg:gap-16 mt-6 md:mt-8 lg:mt-10"
    >
      <!-- Left column: subtitle + CTAs -->
      <div class="flex-1 min-w-0">
        <p class="font-body text-base md:text-lg leading-relaxed text-fg-dim mb-6 md:mb-8 max-w-xl text-wrap-pretty lg:text-xl lg:mb-10">
          {COPY_NEON.heroSub}
        </p>

        <!-- CTAs -->
        <div class="flex gap-3 md:gap-4 flex-wrap">
          <Button href="#reserve" variant="primary">
            {COPY_NEON.ctaPrimary} <Icon name="arrow" />
          </Button>

          <Button href="#menu" variant="outline-secondary">
            {COPY_NEON.ctaSecondary}
          </Button>
        </div>

        <!-- Mobile tonight chip -->
        <div
          class="mt-10 py-3 px-3.5 border border-dashed border-line-strong flex items-center gap-3 font-mono text-xs tracking-wider md:hidden"
        >
          <span class="text-accent">◉</span> BOLIRANA, FÚTBOL Y PARCHE
        </div>
      </div>

      <!-- Right column: static featured card (desktop & tablet) -->
      <div class="hidden md:block mt-8 lg:mt-0 lg:w-80 lg:shrink-0 max-w-xl">
        <div class="py-5 px-5 border border-dashed border-line-strong rounded-xl bg-bg-2 backdrop-blur-sm">
          <div class="font-mono text-xxs tracking-ultra uppercase text-fg-dim mb-3">
            BOLIRANA, FÚTBOL Y PARCHE
          </div>
          <div class="font-display text-3xl leading-none tracking-wider uppercase text-fg mb-2">
            Vení al parche
          </div>
          <div class="font-body text-sm text-fg-dim mb-3">
            Cerveza fría, bolirana con amigos, música y ambiente de barrio sin complicarse.
          </div>
          <div class="inline-block py-1 px-2.5 bg-accent text-bg font-mono text-xs tracking-wide uppercase font-semibold rounded-sm">
            ARMA LA PARTIDA
          </div>
          <div class="mt-4 font-mono text-xs text-accent tracking-wide">
            MARTES A DOMINGO DESDE LAS 6 PM
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
