---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<section
  id="inicio"
  class="relative min-h-[100dvh] flex flex-col justify-center pt-28 pb-16 px-4 sm:px-6 lg:px-12 overflow-hidden bg-background"
  aria-label="Inicio"
>
  <!-- Background Image: Rich photographic warmth matching mockups -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/v2/hero-mobile.png" />
      <img
        src="/images/v2/hero-desktop.png"
        alt="Interior de La Locura Bar en Villavicencio durante la noche"
        class="w-full h-full object-cover object-center md:object-right"
        loading="eager"
        decoding="async"
      />
    </picture>

    <!-- Desktop: Left-side directional dark vignette so text contrasts while right side stays vibrant -->
    <div
      class="hidden md:block absolute inset-y-0 left-0 w-[62%] lg:w-[54%] bg-gradient-to-r from-black via-black/85 to-transparent"
    ></div>

    <!-- Mobile: Gradient overlay balanced for vertical composition -->
    <div
      class="md:hidden absolute inset-0 bg-gradient-to-t from-black via-black/65 to-black/40"
    ></div>

    <!-- Top & Bottom smooth blending shadows -->
    <div class="absolute top-0 inset-x-0 h-32 bg-gradient-to-b from-black/90 to-transparent"></div>
    <div class="absolute bottom-0 inset-x-0 h-28 bg-gradient-to-t from-background to-transparent"></div>
  </div>

  <!-- Content Layer -->
  <div class="relative z-10 max-w-7xl mx-auto w-full my-auto">
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Eyebrow Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-5 rounded-full border border-secondary/90 bg-black/50 backdrop-blur-sm select-none">
        <!-- Location Pin Icon in Amber -->
        <svg class="w-3.5 h-3.5 text-secondary shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7z"/>
          <circle cx="12" cy="9" r="2.5" fill="currentColor"/>
        </svg>
        <span class="font-display text-xs sm:text-sm tracking-[0.18em] text-secondary uppercase font-semibold">
          {SITE_CONFIG.hero.eyebrow}
        </span>
      </div>

      <!-- Main Headline: H1 with Line 1 Cream + Line 2 Hot Magenta -->
      <h1 class="font-display text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] xl:text-[8.5rem] tracking-tight leading-[0.88] uppercase mb-6 select-none">
        <span class="block text-paper">EL PARCHE</span>
        <span class="block text-primary">EMPIEZA AQUÍ.</span>
      </h1>

      <!-- Subtitle Paragraph -->
      <p class="font-body text-base sm:text-lg md:text-xl text-paper/90 leading-relaxed mb-8 sm:mb-10 max-w-xl text-pretty">
        Cerveza fría, bolirrana, música y buena compañía.<br class="hidden sm:inline" />
        Sin tanta vuelta.
      </p>

      <!-- CTA Buttons Matching Mockup Exactly -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <!-- Primary Amber Button -->
        <a
          href="#ubicacion"
          class="inline-flex items-center justify-between sm:justify-center gap-3 bg-secondary hover:bg-gold-soft text-dark font-display text-lg tracking-wider uppercase px-7 py-3.5 rounded-lg font-bold transition-all active:scale-95 shadow-xl shadow-secondary/15 select-none"
        >
          <span class="w-6 h-6 rounded-full bg-dark flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7z"/>
            </svg>
          </span>
          <span>CÓMO LLEGAR</span>
          <svg class="w-5 h-5 stroke-2 fill-none stroke-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <!-- Secondary Outline Button -->
        <a
          href="#carta"
          class="inline-flex items-center justify-between sm:justify-center gap-3 bg-black/45 hover:bg-black/70 border border-white/60 hover:border-white text-white font-display text-lg tracking-wider uppercase px-7 py-3.5 rounded-lg font-bold transition-all active:scale-95 backdrop-blur-xs select-none"
        >
          <!-- Magenta Bottle Icon -->
          <svg class="w-5 h-5 text-primary fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 2h6v4l-2 2v12a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2V8L9 6V2z"/>
            <path d="M9 12h6"/>
          </svg>
          <span>VER LA CARTA</span>
          <svg class="w-5 h-5 stroke-2 fill-none stroke-current text-white/80 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Scroll Down Indicator ("DESLIZA ↓") -->
  <div class="md:hidden relative z-10 mx-auto pt-6 flex flex-col items-center gap-1 opacity-75 animate-bounce select-none">
    <span class="font-display text-[10px] tracking-[0.25em] text-paper uppercase">DESLIZA</span>
    <svg class="w-4 h-4 text-paper stroke-2 fill-none stroke-current" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
