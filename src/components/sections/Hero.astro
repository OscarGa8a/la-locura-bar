---
import { SITE_CONFIG } from '../../data/siteConfig';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section
  id="inicio"
  class="relative min-h-[100dvh] flex flex-col justify-end md:justify-center pt-24 pb-8 md:py-24 px-4 sm:px-6 lg:px-12 overflow-hidden bg-background"
  aria-label="Inicio"
>
  <!-- Background Image: Rich photographic warmth matching mockups -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/v2/hero-mobile.png" />
      <img
        src="/images/v2/hero-desktop.png"
        alt="Interior de La Locura Bar en Villavicencio durante la noche"
        class="w-full h-full object-cover object-center md:object-right"
        loading="eager"
        decoding="async"
      />
    </picture>

    <!-- Desktop: Left-side directional dark vignette so text contrasts while right side stays vibrant -->
    <div
      class="hidden md:block absolute inset-y-0 left-0 w-[62%] lg:w-[54%] bg-gradient-to-r from-black via-black/85 to-transparent"
    ></div>

    <!-- Mobile: Gradient overlay concentrated on bottom where text & buttons sit -->
    <div
      class="md:hidden absolute inset-0 bg-gradient-to-t from-black via-black/75 to-transparent"
    ></div>

    <!-- Top & Bottom smooth blending shadows -->
    <div class="absolute top-0 inset-x-0 h-32 bg-gradient-to-b from-black/90 to-transparent"></div>
    <div class="absolute bottom-0 inset-x-0 h-28 bg-gradient-to-t from-background to-transparent"></div>
  </div>

  <!-- Content Layer: Anchored to the bottom on mobile, centered on desktop -->
  <div class="relative z-10 max-w-7xl mx-auto w-full mt-auto md:my-auto">
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Eyebrow Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-4 sm:mb-5 rounded-full border border-secondary/90 bg-black/50 backdrop-blur-sm select-none">
        <Icon name="pin" size="xs" class="text-secondary shrink-0 stroke-2" />
        <span class="font-display text-xs sm:text-sm tracking-[0.18em] text-secondary uppercase font-semibold">
          {SITE_CONFIG.hero.eyebrow}
        </span>
      </div>

      <!-- Main Headline: H1 with Line 1 Cream + Line 2 Hot Magenta -->
      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] xl:text-[8.5rem] tracking-tight leading-[0.88] uppercase mb-4 sm:mb-6 select-none">
        <span class="block text-paper">EL PARCHE</span>
        <span class="block text-primary">EMPIEZA AQUÍ.</span>
      </h1>

      <!-- Subtitle Paragraph -->
      <p class="font-body text-sm sm:text-lg md:text-xl text-paper/90 leading-relaxed mb-6 sm:mb-10 max-w-xl text-pretty">
        Cerveza fría, bolirrana, música y buena compañía.<br class="hidden sm:inline" />
        Sin tanta vuelta.
      </p>

      <!-- Reusable Atomic Button Primitives -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
        <!-- Primary Amber Button: Clean black pin icon without round circle -->
        <Button
          href="#ubicacion"
          variant="primary"
          size="lg"
          class="justify-between sm:justify-center gap-3 shadow-xl shadow-secondary/15"
        >
          <Icon name="pin" size="sm" class="text-dark shrink-0 stroke-2" />
          <span>CÓMO LLEGAR</span>
          <Icon name="arrow-right" size="sm" class="text-dark shrink-0 stroke-2" />
        </Button>

        <!-- Secondary Outline Button: Detailed beer/liquor bottle icon in hot magenta -->
        <Button
          href="#carta"
          variant="outline"
          size="lg"
          class="justify-between sm:justify-center gap-3"
        >
          <Icon name="bottle" size="sm" class="text-primary shrink-0" />
          <span>VER LA CARTA</span>
          <Icon name="arrow-right" size="sm" class="text-white/80 shrink-0" />
        </Button>
      </div>
    </div>
  </div>
</section>
