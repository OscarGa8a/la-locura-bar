---
import { SITE_CONFIG } from '../../data/siteConfig';

const mapEmbedUrl = `https://www.google.com/maps?q=4.1422,-73.6268&z=16&output=embed`;
---

<section
  id="ubicacion"
  class="relative bg-background text-text py-20 md:py-28 lg:py-36 px-4 sm:px-6 lg:px-12 border-b border-line/40"
  aria-label="Ubicación de La Locura Bar"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl mb-12 lg:mb-16">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span class="font-body text-xs md:text-sm font-semibold tracking-[0.2em] text-accent uppercase">
          {SITE_CONFIG.ubicacion.eyebrow}
        </span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight text-text leading-[0.95] uppercase mb-4 text-balance">
        {SITE_CONFIG.ubicacion.title}
      </h2>
      <p class="font-body text-base md:text-lg text-muted leading-relaxed text-pretty">
        {SITE_CONFIG.ubicacion.description}
      </p>
    </div>

    <!-- Main Grid: Info & Actions (left 5 cols) & Map + Photo (right 7 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      <!-- Info Column -->
      <div class="lg:col-span-5 flex flex-col justify-between bg-surface/70 border border-line/50 p-6 sm:p-8 rounded-sm">
        <div class="space-y-6">
          <!-- Address Block -->
          <div>
            <span class="font-display text-xs tracking-[0.2em] text-accent uppercase block mb-1.5">
              {SITE_CONFIG.ubicacion.addressLabel}
            </span>
            <p class="font-display text-2xl sm:text-3xl text-text uppercase leading-snug">
              {SITE_CONFIG.ubicacion.address}
            </p>
            <p class="font-body text-sm text-muted mt-1">
              Barrio Embudo · Villavicencio, Meta
            </p>
          </div>

          <!-- Verified Badges -->
          <div class="pt-6 border-t border-line/40 space-y-3">
            <div class="flex items-center gap-3 text-muted text-sm font-body">
              <span class="w-2 h-2 rounded-full bg-secondary"></span>
              <span>Punto de referencia: Sector tradicional de la ciudad</span>
            </div>
            <div class="flex items-center gap-3 text-muted text-sm font-body">
              <span class="w-2 h-2 rounded-full bg-secondary"></span>
              <span>Ambiente seguro y acogedor de barrio</span>
            </div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="pt-8 space-y-3">
          <a
            href={SITE_CONFIG.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center bg-secondary text-dark font-display text-base uppercase tracking-wider py-3.5 px-6 rounded-sm font-semibold hover:bg-gold-soft active:scale-95 transition-all text-center shadow-md shadow-secondary/10"
          >
            {SITE_CONFIG.ubicacion.ctaMaps} ↗
          </a>
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center bg-surface hover:bg-surface-raised border border-line text-text font-display text-base uppercase tracking-wider py-3.5 px-6 rounded-sm font-semibold active:scale-95 transition-all text-center"
          >
            {SITE_CONFIG.ubicacion.ctaWhatsApp}
          </a>
        </div>
      </div>

      <!-- Map & Location Asset Column -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <!-- Interactive Map Frame -->
        <div class="rounded-sm overflow-hidden border border-line/60 bg-surface min-h-[300px] sm:min-h-[360px] relative aspect-video">
          <iframe
            title={SITE_CONFIG.ubicacion.mapTitle}
            src={mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full filter contrast-105"
          ></iframe>
        </div>

        <!-- Authentic Location Image -->
        <div class="rounded-sm overflow-hidden border border-line/40 aspect-21/9 max-h-[160px] relative">
          <img
            src={SITE_CONFIG.ubicacion.image}
            alt={SITE_CONFIG.ubicacion.imageAlt}
            class="w-full h-full object-cover object-center"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
