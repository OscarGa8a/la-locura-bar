---
import SectionHeader from "../ui/SectionHeader.astro";
import { config } from "../../data/config";
import Icon from "../ui/Icons.astro";
import Button from "../ui/Button.astro";

const { address, neighborhood, location, whatsappNumber, whatsapp } = config;

const coordinates = `${location.lat},${location.lng}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${coordinates}&z=15&output=embed`;
const directionsUrl = config.googleMapsUrl;
---

<section id="location" class="py-14 px-5 md:py-20 md:px-8 lg:py-24 lg:px-12">
  <div class="max-w-7xl mx-auto" data-animate-container>
    <SectionHeader
      eyebrow="Dónde estamos"
      title="UBICACIÓN"
      data-animate="fade-up"
    />
  
    <div class="flex flex-col lg:flex-row gap-6 md:gap-8 justify-start mt-8">
      <!-- Stylized map -->
      <div class="aspect-4/3 relative overflow-hidden rounded-2xl border border-line shadow-[0_0_30px_rgba(0,0,0,0.5)] w-full lg:w-1/2 md:aspect-video" data-animate="fade-left" data-animate-delay="1">
        <iframe
          title="Ubicación de La Locura Bar en Villavicencio"
          src={mapEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          aria-describedby="service-map-help"
        ></iframe>
        <p id="service-map-help" class="visually-hidden">
          Mapa embebido con la ubicación de La Locura Bar. También puedes usar el botón Cómo llegar para abrir la ficha oficial en Google Maps.
        </p>
      </div>
    
      <div class="flex-1 flex flex-col justify-between" data-animate="fade-right" data-animate-delay="2">
        <!-- Info rows -->
        <div class="flex flex-col gap-3">
          <div class="p-4 rounded-xl border border-line bg-bg-2 flex items-center gap-3.5 transition-all hover:border-line-strong" data-animate="fade-up" data-animate-delay="1">
            <div class="w-10 h-10 flex items-center justify-center border border-accent/30 bg-accent/10 rounded-xl text-accent shrink-0">
              <Icon name="pin" />
            </div>
            <div>
              <div class="font-body text-sm font-semibold text-fg md:text-base">{address}</div>
              <div class="font-mono text-xs text-muted mt-0.5 uppercase tracking-wider">{neighborhood}</div>
            </div>
          </div>
      
          <div class="p-4 rounded-xl border border-line bg-bg-2 flex items-center gap-3.5 transition-all hover:border-line-strong" data-animate="fade-up" data-animate-delay="2">
            <div class="w-10 h-10 flex items-center justify-center border border-accent-2/30 bg-accent-2/10 rounded-xl text-accent-2 shrink-0">
              <Icon name="clock" />
            </div>
            <div>
              <div class="font-body text-sm font-semibold text-fg md:text-base">{config.horario1Text}</div>
              <div class="font-body text-sm font-semibold text-fg md:text-base">{config.horario2Text}</div>
              <div class="font-mono text-xs text-muted mt-0.5 uppercase tracking-wider">{config.horario3Text}</div>
            </div>
          </div>
      
          <a
            href={`https://wa.me/${whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_click"
            data-event-location="location_card"
            class="group p-4 rounded-xl border border-line bg-bg-2 flex items-center justify-between gap-3.5 transition-all hover:border-accent hover:shadow-[0_0_20px_rgba(255,45,135,0.15)]"
            data-animate="fade-up"
            data-animate-delay="3"
          >
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 flex items-center justify-center border border-accent/30 bg-accent/10 rounded-xl text-accent shrink-0 transition-transform group-hover:scale-105">
                <Icon name="phone" />
              </div>
              <div>
                <div class="font-body text-sm font-semibold text-fg md:text-base group-hover:text-accent transition-colors">{whatsappNumber}</div>
                <div class="font-mono text-xs text-muted mt-0.5 uppercase tracking-wider">WhatsApp para reservas</div>
              </div>
            </div>
            <span class="text-accent text-xs font-mono opacity-0 group-hover:opacity-100 transition-opacity uppercase tracking-wider hidden sm:inline">
              Chat →
            </span>
          </a>
        </div>

        <!-- Cómo llegar button -->
        <div class="mt-5 md:mt-6" data-animate="fade-up" data-animate-delay="4">
          <Button
            variant="outline-secondary"
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="map_click"
            data-event-location="location_section"
            class="w-full sm:w-auto"
          >
            <span>Abrir en Google Maps</span>
            <Icon name="arrow" />
          </Button>
        </div>
      </div>
    </div>  
  </div>
</section>
