---
interface Props {
  variant?: 'primary' | 'outline' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'link';
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  'aria-label'?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = href ? 'link' : 'button',
  class: className = '',
  target,
  rel,
  disabled = false,
  ...rest
} = Astro.props;

const baseClasses =
  'font-display tracking-wider uppercase font-bold inline-flex items-center justify-center gap-2.5 select-none transition-all duration-200 cursor-pointer active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary disabled:opacity-40 disabled:pointer-events-none';

const sizeClasses = {
  sm: 'py-2 px-4 text-xs sm:text-sm rounded-lg',
  md: 'py-3 px-5 text-base rounded-lg',
  lg: 'py-3.5 px-7 text-lg rounded-lg',
};

const variantClasses = {
  primary:
    'bg-secondary hover:bg-gold-soft text-dark shadow-md shadow-secondary/10',
  outline:
    'bg-black/45 hover:bg-black/70 border border-white/60 hover:border-white text-white backdrop-blur-xs',
  secondary:
    'bg-surface hover:bg-surface-raised border border-line text-text shadow-xs',
  ghost:
    'bg-transparent hover:bg-surface text-muted hover:text-text',
};

const fullClass = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`.trim();
---

{
  type === 'link' || href ? (
    <a href={href} target={target} rel={rel} class={fullClass} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type === 'submit' ? 'submit' : 'button'} disabled={disabled} class={fullClass} {...rest}>
      <slot />
    </button>
  )
}
