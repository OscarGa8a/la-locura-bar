---
interface Props {
  variant?: 'primary' | 'outline' | 'secondary' | 'outline-secondary';
  href?: string;
  type?: 'submit' | 'link';
  class?: string;
  target?: string;
  rel?: string;
  [key: `data-${string}`]: string | undefined;
  'aria-label'?: string;
}

const { variant = 'primary', href, type = 'link', class: className = '', target, rel, ...rest } = Astro.props;

const base = 'py-3 px-5 rounded-lg font-display text-base tracking-wide uppercase inline-flex items-center justify-center gap-2 select-none cursor-pointer transition-all duration-200 ease-out active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 md:py-3.5 md:px-6 md:text-sm';

const variants = {
  primary: 'bg-accent text-bg hover:bg-accent/90 shadow-[0_0_20px_rgba(255,45,135,0.25)] hover:shadow-[0_0_30px_rgba(255,45,135,0.45)] active:shadow-none',
  outline: 'border border-accent text-accent hover:bg-accent/10 hover:border-accent hover:shadow-[0_0_20px_rgba(255,45,135,0.2)]',
  secondary: 'bg-accent-2 text-bg hover:bg-accent-2/90 shadow-[0_0_20px_rgba(0,229,255,0.2)] hover:shadow-[0_0_30px_rgba(0,229,255,0.4)] active:shadow-none',
  'outline-secondary': 'border border-accent-2 text-accent-2 hover:bg-accent-2/10 hover:border-accent-2 hover:shadow-[0_0_20px_rgba(0,229,255,0.2)]',
};
---

{
  type === 'link' ? (
    <a href={href} target={target} rel={rel} class={`${base} ${variants[variant]} ${className}`} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="submit" class={`${base} ${variants[variant]} ${className}`} {...rest}>
      <slot />
    </button>
  )
}
